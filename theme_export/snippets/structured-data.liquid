{% if template contains 'index' %}
 <script type="application/ld+json">
   {
   "@context": "https://schema.org",
   "@type": "Organization",
   "name": "Cool Colors",
   "url": {{ shop.url | json }},
   {% if page_image %}
   "logo": {{ page_image | image_url: width: 600 | json }},
   {% endif %}
   "contactPoint": {
     "@type": "ContactPoint",
     "contactType": "customer support",
     "email": {{ shop.email | json }},
     "url": {{ shop.url | json }}
   },
   "sameAs": [
    {{ shop.url | json }}
      {%- if settings.facebook_url != blank -%},{{ settings.facebook_url | json }}{%- endif -%}
      {%- if settings.twitter_url != blank -%},{{ settings.twitter_url | json }}{%- endif -%}
      {%- if settings.pinterest_url != blank -%},{{ settings.pinterest_url | json }}{%- endif -%}
      {%- if settings.instagram_url != blank -%},{{ settings.instagram_url | json }}{% endif -%}
     ]
   }
 </script>
{% elsif template contains 'article' %}
 <script type="application/ld+json">
   {
     "@context": "https://schema.org",
     "@type": "BlogPosting",
     "author": {
       "@type": "Person",
       "name": {{ article.author | json }},
        "url": "{{ shop.url }}{{ article.url }}"
     },
     "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}+5:30",
     "headline": {{ article.title | strip_html | escape | json }},
     "image": {{ article.image | json }},
     "publisher": {
       "@type": "Organization",
       "name": {{ shop.name | json }},
       "url": {{ shop.url | json }}
       {% if page_image %},
       "logo": {
         "@type": "ImageObject",
         "url": {{ page_image | image_url: width: 600 | json }}
       }
       {% endif %}
     },
     "dateModified": "{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}+5:30",
     "mainEntityOfPage": {{ article.url | json }}
   }
 </script>
{% elsif template contains 'product' %}
{% comment %} <script type="application/ld+json">
   {
     "@context": "https://schema.org",
     "@type": "Product",
     "id": {{ product.handle | json }},
     "url": {{ shop.url | append: product.url | json }},
     "image": {{ product.featured_image | image_url: width: 1024 | json }},
     "name": {{ product.title | strip_html | escape | json }},
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | json }}
      },
     "description": {{ product.description | strip_html | json }},
     {%- if product.variants.first.sku != blank -%}
       "sku": {{ product.variants.first.sku | json }},
     {%- else -%}
       "sku": {{ product.variants.first.id | json }},
     {%- endif -%}
     {%- if product.variants.first.barcode.size == 12 -%}
       "gtin12": {{ product.variants.first.barcode }},
     {%- endif -%}
     {%- if product.variants.first.barcode.size == 13 -%}
       "gtin13": {{ product.variants.first.barcode }},
     {%- endif -%}
     {%- if product.variants.first.barcode.size == 14 -%}
       "gtin14": {{ product.variants.first.barcode }},
     {%- endif -%}
     "offers": [
        {% for variant in product.variants %}
        {
           "@type": "Offer",
           "price": {{ variant.price | money_without_currency | json | remove: "," }},
           "priceCurrency": {{ cart.currency.iso_code | json }},
           "availability": "http://schema.org/InStock",
           "priceValidUntil": "2030-01-01",
           "url": {{ product.url | json }}
         }{% unless forloop.last %},{% endunless %}
       {% endfor %}
     ]
    {%- if product.metafields.spr.reviews -%}
    ,"aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ product.metafields.spr.reviews | split: 'ratingValue" content="' | last | split: '"' | first | plus: 0 }},
      "ratingCount": {{ product.metafields.spr.reviews | split: 'reviewCount" content="' | last | split: '"' | first | plus: 0 }}
    }
    {%- endif -%}
   }
 </script>{% endcomment %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "brand": {"@type": "Brand","name": {{ product.vendor | json }}},
    "sku": "{{ product.selected_or_first_available_variant.sku }}",
    "mpn": "{{ product.selected_or_first_available_variant.barcode }}",
    "description": {{ product.description | strip_html | json }},
    "url": "{{ shop.secure_url }}{{ product.url }}",
   {% comment %} {%- if product.featured_image -%}
    {%- assign image_size = product.featured_image.width | append: 'x' -%}
    "image": "https:{{ product.featured_image.src | img_url: image_size }}",
    {%- else -%}
    "image": "https:{{ product.images[0].src | img_url }}",
    {%- endif -%} {% endcomment %}
    "image": {
    "@type": "ImageObject",
    "url": "https:{{ product.featured_image.src | img_url: image_size }}",
    "name": {{ product.title | json }},
    "width": {{ product.featured_image.width }},
    "height": {{ product.featured_image.height }}
  },
    "itemCondition": "https://schema.org/NewCondition",
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "price": {{ variant.price | money_without_currency | remove: "," | json }},
          "priceCurrency": "{{ shop.currency }}",
          "itemCondition": "https://schema.org/NewCondition",
          "url": "{{ shop.secure_url }}{{ variant.url }}",
          "sku": "{{ variant.sku }}",
          "mpn": "{{ variant.barcode }}",
          "availability" : "https://schema.org/{%- if product.available -%}InStock{%- else -%}OutOfStock{%- endif -%}",
          "priceValidUntil": {{ "today" | date: '%s' | plus: 2592000 | date: "%Y-%m-%d" | json }},
        {%- if variant.barcode.size == 12 -%}
          "gtin12": "{{ variant.barcode }}"
        {%- elsif variant.barcode.size == 13 -%}
          "gtin13": "{{ variant.barcode }}"
        {%- else -%}
          "gtin14": "{{ variant.barcode }}"
        {%- endif -%}}
        {%- if forloop.index < product.variants.size -%},{%- endif -%}
      {%- endfor -%}
    ]

