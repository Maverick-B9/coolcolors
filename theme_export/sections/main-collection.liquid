
<!-- BEGIN USF -->

{%- liquid

  assign collection_link = ''

  if collection.handle
    assign collection_link = '/collections/' | append: collection.handle
  elsif collection.products.first.type == collection.title
    assign collection_link = collection.title | url_for_type
  elsif collection.products.first.vendor == collection.title
    assign collection_link = collection.title | url_for_vendor
  endif

  assign number = section.settings.products_per_page

  case section.settings.products_per_row
    when 2
      assign prod_grid = 'span-6'
    when 3
      assign prod_grid = 'span-4'
    when 4
      assign prod_grid = 'span-3'
    when 5
      assign prod_grid = 'span-one-fifth'
    when 6
      assign prod_grid = 'span-2'
  endcase

  assign show_sidebar = false
  assign filtering_enabled = false
  assign horizontal_filtering_enabled = false
  assign sort_by_enabled = false

  for block in section.blocks
    if block.type == 'menu' or block.type == 'image' or block.type == 'text' or block.type == 'side_filter'
      assign show_sidebar = true
    endif
    if block.type == 'dropdown_filter'
      assign horizontal_filtering_enabled = true
      assign horizontal_block_id = block.id
      assign show_filter_swatches = block.settings.show_filter_swatches
    endif
    if block.type == 'side_filter'
      assign filtering_enabled = true
    endif
  endfor

  if section.settings.sort_by
    assign sort_by_enabled = true
  endif

  assign filter_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign filter_count = 1
      endif
    endif

    assign filter_count = filter_count | plus: filter.active_values.size
  endfor

  if section.settings.show_image and collection.image != blank
    assign collection_image = true
    assign desc_width = 'span-9'
  else
    assign collection_image = false
    assign desc_width = 'span-12'
  endif

  assign mobile_1pr = false
  if section.settings.mobile_1pr
    assign mobile_1pr = true
  endif
  assign show_sidebar = false
  -%}

<!--begin usf settings-->

		{% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                   {%- liquid

      if settings.quickview_type == 'modal'
        assign quickview_classes = 'js-modal-open'
        assign quickview_settings = 'data-wau-modal-target="quickview"'
      else
        assign quickview_classes = 'js-slideout-open'
        assign quickview_settings = 'data-wau-slideout-target="quickview" data-slideout-direction="right"'
      endif

    -%}
          {% comment %} <script>
            window._usf_quickview_classes = {{ quickview_classes | json }};
            window._usf_quickview_settings = {{ quickview_settings | json }};
            window._usfNoImage =  {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' | json }};
            window._usfSaleText = {{ 'products.general.sale' | t | json }};
            window._usfSoldOutText = {{ 'products.general.sold' | t | json }};
            window._usfNewText = {{ 'products.general.new' | t | json }};
            window._usfQuickViewText = {{ 'products.general.quick_view' | t | json }};
            window._usfUnitPriceText = {{ 'products.product.unit_price_label' | t | json }};
            window._usfRegulatPriceText = {{ 'products.general.regular_price' | t | json }};
            window._usfFromPriceHtml = {{ 'products.product.from_lowest_price_html' | t | json }};
            window._usfSalePriceText = {{ 'products.general.sale_price' | t | json }};
            window._usfGlobalSettings = {
              product_image_size: {{ settings.product_image_size | json }},
              secondary_images_hover: {{ settings.secondary_images_hover | json }},
              quickview: {{ settings.quickview | json }},
              vendor: {{ settings.vendor | json }},
              color_swatch_style: {{ settings.color_swatch_style | json }},
              use_swatch_images: {{ settings.use_swatch_images | json }},
              icon_style: {{ settings.icon_style | json }},
              sale_items: {{ settings.sale_items | json }},
              switch_image: {{ settings.switch_image | json }},
              quickview_type: {{ settings.quickview_type | json }},
              alternate_colors: {{ settings.alternate_colors | json }},
            };
            window._usfSectionSettings = {
              products_per_row: {{ section.settings.products_per_row | json }},
              mobile_1pr: {{ section.settings.mobile_1pr | json }}
            };
            window._usf_prod_grid = {{ prod_grid | json }};
            window._usfCollectionById = {};
            {% for collection in collections %}
            window._usfCollectionById[{{ collection.id | json }}] = {{ collection.handle | json }};
            {% endfor %}
          </script> {% endcomment %}
          
<!--end usf settings-->

