{% comment %}
  Shop by Category section.
  Add "Category" blocks in the theme editor: each block has an image, label, and optional link.
{% endcomment %}

<div class="shop-category" style="
  --shop-category-columns-desktop: {{ section.settings.columns_desktop }};
  --shop-category-columns-mobile: {{ section.settings.columns_mobile }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background:#fff; color:#0D1117;
">
  <div class="shop-category__inner page-width">
    {% if section.settings.heading != blank %}
      <h2 class="shop-category__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.layout == 'asymmetric' and section.blocks.size > 0 %}
      <div class="sbc">
        <div class="sbc__top">
          {% for block in section.blocks limit: 4 %}
            {% render 'sbc-tile', block: block, pos: forloop.index %}
          {% endfor %}
        </div>
        {% if section.blocks.size > 4 %}
          <div class="sbc__bottom sbc__bottom--{{ section.blocks.size | minus: 4 }}">
            {% for block in section.blocks offset: 4 %}
              {% render 'sbc-tile', block: block, pos: 'b' %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% elsif section.blocks.size > 0 %}
      <ul class="shop-category__list">
        {% for block in section.blocks %}
          <li class="shop-category__item" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="shop-category__link">
            {% else %}
              <div class="shop-category__link">
            {% endif %}

              <span class="shop-category__image-wrap">
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 800 }} 800w"
                    sizes="(min-width: 990px) 300px, 45vw"
                    alt="{{ block.settings.image.alt | default: block.settings.label | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                    class="shop-category__image"
                  >
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'shop-category__image shop-category__image--placeholder' }}
                {% endif %}
              </span>

              {% if block.settings.label != blank %}
                <span class="shop-category__label">{{ block.settings.label }}</span>
              {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .shop-category, .shop-category * { font-family:'Inter',system-ui,-apple-system,sans-serif; box-sizing:border-box; }
  .shop-category__inner {
    max-width: 1500px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .shop-category__heading {
    margin: 0 0 40px 0;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-align: center;
  }

  .shop-category__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% / var(--shop-category-columns-desktop, 6)) - 20px);
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    padding-bottom: 4px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .shop-category__list::-webkit-scrollbar {
    display: none;
  }

  .shop-category__item {
    min-width: 0;
    list-style: none;
    margin: 0;
  }

  .shop-category__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: currentColor;
  }

  .shop-category__image-wrap {
    display: block;
    width: 100%;
    aspect-ratio: 5 / 6;
    background: #eeeeee;
    overflow: hidden;
  }

  .shop-category__image,
  .shop-category__image--placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .shop-category__link:hover .shop-category__image {
    transform: scale(1.04);
  }

  .shop-category__label {
    margin-top: 18px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .shop-category__heading {
      margin-bottom: 24px;
      font-size: 19px;
    }

    .shop-category__list {
      grid-auto-columns: calc((100% / var(--shop-category-columns-mobile, 2.3)) - 12px);
      gap: 14px;
    }

    .shop-category__label {
      margin-top: 12px;
      font-size: 11px;
    }
  }

  .sbc{display:flex;flex-direction:column;gap:4px}
  .sbc__top{display:grid;grid-template-columns:1.35fr 1fr 1.35fr;grid-template-rows:repeat(2,minmax(0,1fr));gap:4px;height:clamp(420px,46vw,640px)}
  .sbc__top .sbc__tile:nth-child(1){grid-column:1;grid-row:1/3}
  .sbc__top .sbc__tile:nth-child(2){grid-column:2;grid-row:1}
  .sbc__top .sbc__tile:nth-child(3){grid-column:2;grid-row:2}
  .sbc__top .sbc__tile:nth-child(4){grid-column:3;grid-row:1/3}
  .sbc__bottom{display:grid;gap:4px;grid-template-columns:repeat(2,1fr);height:clamp(220px,24vw,340px)}
  .sbc__bottom--1{grid-template-columns:1fr}
  .sbc__bottom--2{grid-template-columns:1.2fr 1fr}
  .sbc__bottom--3{grid-template-columns:repeat(3,1fr)}
  .sbc__tile{position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#d9d9dc;color:#fff;text-decoration:none;min-height:0}
  .sbc__tile img,.sbc__tile svg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s ease}
  .sbc__tile::after{content:"";position:absolute;inset:0;background:rgba(0,0,0,.18);transition:background .3s}
  .sbc__tile:hover img{transform:scale(1.04)}
  .sbc__tile:hover::after{background:rgba(0,0,0,.3)}
  .sbc__label{position:relative;z-index:1;font-size:13px;font-weight:400;letter-spacing:.28em;text-align:center;padding:0 12px}
  @media screen and (max-width:749px){
    .sbc__top{grid-template-columns:1fr 1fr;grid-template-rows:240px 190px 190px;height:auto}
    .sbc__top .sbc__tile:nth-child(1){grid-column:1;grid-row:1/3}
    .sbc__top .sbc__tile:nth-child(2){grid-column:2;grid-row:1}
    .sbc__top .sbc__tile:nth-child(3){grid-column:2;grid-row:2}
    .sbc__top .sbc__tile:nth-child(4){grid-column:1/3;grid-row:3}
    .sbc__bottom{height:200px}
    .sbc__label{font-size:11px;letter-spacing:.2em}
  }
{% endstylesheet %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const lists = document.querySelectorAll('.shop-category__list');

    lists.forEach(function (list) {
      if (list.dataset.looped) return;
      list.dataset.looped = '1';
      /*
       * Duplicate the items once so there is always a second copy
       * waiting off-screen. This lets us loop the scroll position
       * with a simple modulo instead of snapping back to 0, which
       * removes the visible pause/jump at the end of the row.
       */
      const originalItems = Array.from(list.children);
      if (originalItems.length === 0) return;

      originalItems.forEach(function (item) {
        const clone = item.cloneNode(true);
        clone.setAttribute('aria-hidden', 'true');
        clone.querySelectorAll('a').forEach(function (link) {
          link.setAttribute('tabindex', '-1');
        });
        list.appendChild(clone);
      });

      let scrollSpeed = 1;      // pixels per frame — raise for a faster marquee
      let isPaused = false;
      let resumeTimeout;

      function autoScroll() {
        if (!isPaused) {
          list.scrollLeft += scrollSpeed;

          /*
           * Half of the (now doubled) scrollWidth is exactly one
           * full pass through the original items. Wrapping there
           * with modulo keeps the motion perfectly continuous.
           */
          const loopPoint = list.scrollWidth / 2;
          if (list.scrollLeft >= loopPoint) {
            list.scrollLeft -= loopPoint;
          }
        }

        requestAnimationFrame(autoScroll);
      }

      function pauseThenResume(delay) {
        isPaused = true;
        clearTimeout(resumeTimeout);
        resumeTimeout = setTimeout(function () {
          isPaused = false;
        }, delay);
      }

      list.addEventListener('mouseenter', function () { isPaused = true; });
      list.addEventListener('mouseleave', function () { isPaused = false; });
      list.addEventListener('touchstart', function () { isPaused = true; }, { passive: true });
      list.addEventListener('touchend', function () { pauseThenResume(1500); }, { passive: true });
      list.addEventListener('wheel', function () { pauseThenResume(1500); }, { passive: true });

      requestAnimationFrame(autoScroll);
    });
  });
</script>
{% schema %}
{
  "name": "Shop by category",
  "tag": "section",
  "class": "shopify-section--shop-category",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "asymmetric", "options": [
      { "value": "asymmetric", "label": "Asymmetric grid (first 4 tiles + extras below)" },
      { "value": "marquee", "label": "Scrolling row (previous design)" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "range", "id": "columns_desktop", "label": "Columns visible (desktop)", "min": 3, "max": 8, "step": 1, "default": 6 },
    { "type": "range", "id": "columns_mobile", "label": "Columns visible (mobile)", "min": 1.5, "max": 3.5, "step": 0.1, "default": 2.3 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Category" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        { "type": "category", "settings": { "label": "Shirts" } },
        { "type": "category", "settings": { "label": "T-Shirts" } },
        { "type": "category", "settings": { "label": "Hoodies" } },
        { "type": "category", "settings": { "label": "Bottoms" } },
        { "type": "category", "settings": { "label": "Accessories" } },
        { "type": "category", "settings": { "label": "Collections" } }
      ]
    }
  ]
}
{% endschema %}
