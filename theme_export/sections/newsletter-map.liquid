{%- endcapture -%}
{%- assign builtin_rows = builtin_raw | split: ';;' -%}
{%- if section.blocks.size > 0 -%}
  {%- assign items = section.blocks -%}{%- assign use_builtin = false -%}
{%- else -%}
  {%- assign items = builtin_rows -%}{%- assign use_builtin = true -%}
{%- endif -%}

<section class="lm" id="lm-{{ section.id }}" style="--lm-bg:{{ section.settings.bg }}"
  data-l-store="{{ section.settings.label_store | escape }}"
  data-l-office="{{ section.settings.label_office | escape }}"
  data-l-mfg="{{ section.settings.label_mfg | escape }}"
  data-l-show="{{ section.settings.label_all | escape }}"
  data-l-hide="{{ section.settings.label_hide | escape }}">
  <div class="lm__main">
  <div class="lm__wrap">
    <div class="lm__side">
      <div class="lm__head">
        {%- if section.settings.map_title != blank -%}<p class="lm__title">{{ section.settings.map_title }}</p>{%- endif -%}
        {%- if section.settings.map_hint != blank -%}<p class="lm__hint">{{ section.settings.map_hint }}</p>{%- endif -%}
      </div>
      <div class="lm__ctl">
        <div class="lm__chips">
          <button type="button" class="lm__chip lm__all" aria-expanded="false">&#9776; {{ section.settings.label_all }}</button>
          <button type="button" class="lm__chip" data-kind="store"><i></i>{{ section.settings.label_store }}</button>
          <button type="button" class="lm__chip" data-kind="office"><i></i>{{ section.settings.label_office }}</button>
          <button type="button" class="lm__chip" data-kind="manufacturing"><i></i>{{ section.settings.label_mfg }}</button>
        </div>
      </div>
      <div class="lm__out">
        <div class="lm__info" aria-live="polite">
          <h3 data-name></h3>
          <p data-addr></p>
          <a class="lm__gm" data-gm href="#" target="_blank" rel="noopener">Open in Google Maps &#8599;</a>
        </div>
        <div class="lm__list" aria-label="All locations"></div>
      </div>
    </div>
    <div class="lm__map">
      <img src="{{ section.settings.map_file | asset_url }}" alt="Map of India" width="405" height="455" loading="lazy">
      {%- for item in items -%}
        {%- if use_builtin -%}
          {%- assign f = item | split: '|' -%}
          {%- assign i_kind = f[0] | strip -%}
          {%- assign i_name = f[1] | strip -%}
          {%- assign i_addr = f[2] | strip -%}
          {%- assign i_coords = f[3] | strip -%}
          {%- assign i_url = '' -%}
          {%- assign i_attr = '' -%}
        {%- else -%}
          {%- assign i_kind = item.settings.kind -%}
          {%- assign i_name = item.settings.title -%}
          {%- assign i_addr = item.settings.address -%}
          {%- assign i_coords = item.settings.coordinates -%}
          {%- assign i_url = item.settings.maps_url -%}
          {%- assign i_attr = item.shopify_attributes -%}
        {%- endif -%}
        {%- assign parts = i_coords | split: ',' -%}
        {%- assign lat = parts[0] | strip -%}
        {%- assign lon = parts[1] | strip -%}
        {%- if lat != blank and lon != blank -%}
          {%- assign px = lon | times: 3.0753 | minus: 206.58 | round: 2 -%}
          {%- assign ty = lat | times: 3.1938 -%}
          {%- assign py = 124.64 | minus: ty | round: 2 -%}
          {%- assign gm = i_url -%}
          {%- if gm == blank -%}{%- assign gm = 'https://www.google.com/maps/search/?api=1&query=' | append: lat | append: ',' | append: lon -%}{%- endif -%}
          <button type="button" class="lm__pin lm__pin--{{ i_kind }}" style="left:{{ px }}%;top:{{ py }}%" data-kind="{{ i_kind }}" data-name="{{ i_name | escape }}" data-addr="{{ i_addr | escape }}" data-url="{{ gm | escape }}" aria-label="{{ i_name | escape }}" {{ i_attr }}></button>
          {%- assign tipx = 'c' -%}{%- if px < 30 -%}{%- assign tipx = 'l' -%}{%- elsif px > 70 -%}{%- assign tipx = 'r' -%}{%- endif -%}
          {%- assign tipy = 'top' -%}{%- if py < 24 -%}{%- assign tipy = 'bot' -%}{%- endif -%}
          <span class="lm__tip lm__tip--{{ tipx }} lm__tip--{{ tipy }}" style="left:{{ px }}%;top:{{ py }}%" aria-hidden="true">
            <small>{% if i_kind == 'manufacturing' %}{{ section.settings.label_mfg }}{% elsif i_kind == 'store' %}{{ section.settings.label_store }}{% else %}{{ section.settings.label_office }}{% endif %}</small>
            <strong>{{ i_name }}</strong>
            {%- if i_addr != blank -%}<em>{{ i_addr }}</em>{%- endif -%}
          </span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  </div>
  <div class="lm__news">
    <div class="lm__newsin">
      <div class="lm__newstxt">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
      </div>
      {%- form 'customer', class: 'lm__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="lm__ok">Thanks for subscribing!</p>
        {%- else -%}
          {%- if form.errors -%}<div class="lm__err">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="lm__row">
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="email" name="contact[email]" placeholder="Enter your email" required aria-label="Email">
            <button type="submit">Subscribe</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

</section>

<style>
  .lm{ background:var(--lm-bg,#000); color:#fff; padding:64px 32px 48px; }
  .lm, .lm *{ box-sizing:border-box; }
  .lm__main{ max-width:1000px; margin:0 auto; }
  .lm__wrap{ display:grid; grid-template-columns:minmax(0,1fr) minmax(0,420px); gap:48px; align-items:center; }
  .lm__title{ margin:0 0 6px; font-size:12px; font-weight:700; letter-spacing:.22em; text-transform:uppercase; color:#fff; display:flex; align-items:center; gap:10px; }
  .lm__title::before{ content:''; width:22px; height:2px; background:#D92231; }
  .lm__hint{ margin:0 0 16px; font-size:13px; line-height:1.45; color:#8a8a8a; }
  .lm__news{ max-width:1000px; margin:48px auto 0; background:#111; border:1px solid #2c2c2c; border-radius:20px; padding:24px 32px; }
  .lm__newsin{ display:flex; align-items:center; justify-content:space-between; gap:28px; flex-wrap:wrap; }
  .lm__newstxt h2{ margin:0 0 4px; font-size:22px; font-weight:600; line-height:1.2; letter-spacing:-.01em; color:#fff; }
  .lm__newstxt p{ margin:0; font-size:14px; line-height:1.5; color:#8a8a8a; max-width:420px; }
  .lm__form{ flex:1 1 340px; max-width:460px; margin:0; }
  .lm__row{ display:flex; gap:10px; }
  .lm__row input[type=email]{ flex:1 1 0 !important; width:auto !important; min-width:0; height:auto !important; margin:0 !important; box-shadow:none; border:1px solid #2c2c2c; background:#1c1c1c; color:#fff; border-radius:100px; padding:14px 20px; font-size:14px; }
  .lm__row button{ flex:0 0 auto; width:auto !important; min-width:0; height:auto !important; margin:0 !important; padding:14px 26px !important; border:0 !important; background:#D92231; color:#fff; border-radius:100px; font-weight:600; font-size:14px; cursor:pointer; }
  .lm__row button:hover{ background:#B81C29; }
  .lm__form .lm__ok{ margin:0; color:#fff; font-weight:600; }
  .lm__form .lm__err{ color:#ff6b73; font-size:13px; margin:0 0 10px; }

  /* filter chips + Show All button */
  .lm__chips{ display:flex; gap:12px; flex-wrap:wrap; margin-bottom:18px; }
  .lm .lm__chip{ touch-action:manipulation; display:flex; align-items:center; gap:10px; width:auto; min-height:0; margin:0; padding:13px 20px; border-radius:12px; border:1px solid #2c2c2c; background:#1c1c1c; color:#8a8a8a; font-family:inherit; font-size:15px; font-weight:500; line-height:1.2; cursor:pointer; }
  .lm__chip i{ width:10px; height:10px; border-radius:50%; display:block; flex:0 0 auto; }
  .lm__chip[data-kind=office] i{ background:#ff4d4f; } .lm__chip[data-kind=manufacturing] i{ background:#2f95ff; } .lm__chip[data-kind=store] i{ background:#2ecc71; }
  .lm .lm__chip.is-on{ background:#000; border-color:#fff; color:#fff; }
  .lm .lm__all{ background:#D92231; border-color:#D92231; color:#fff; font-weight:600; }
  .lm .lm__all.is-on{ background:#fff; border-color:#fff; color:#000; }

  /* single-store card */
  .lm__info{ background:#1c1c1c; border-radius:16px; border-left:5px solid #3a3a3a; padding:26px 28px; min-height:150px; transition:opacity .15s; }
  .lm__info.is-sw{ opacity:0; }
  .lm__info.lm--hide{ display:none; }
  .lm__info h3{ margin:0 0 12px; font-size:19px; font-weight:600; line-height:1.3; color:#fff; }
  .lm__info p{ margin:0; color:#8a8a8a; font-size:16px; line-height:1.5; }
  .lm .lm__gm{ display:inline-flex; align-items:center; gap:8px; margin-top:18px; padding:11px 18px; border-radius:10px; background:#fff; color:#000; font-size:14px; font-weight:500; text-decoration:none; }
  .lm .lm__gm:hover{ background:#e9e9e9; }

  /* all-locations list */
  .lm__list{ display:none; background:#1c1c1c; border-radius:16px; padding:6px 8px 6px 20px; max-height:380px; overflow-y:auto; scrollbar-color:#444 transparent; }
  .lm__list.is-open{ display:block; }
  .lm__grp{ margin:14px 0 4px; display:flex; align-items:center; gap:8px; font-size:11px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:#8a8a8a; }
  .lm__grp i{ width:8px; height:8px; border-radius:50%; display:block; }
  .lm__grp--store i{ background:#2ecc71; } .lm__grp--office i{ background:#ff4d4f; } .lm__grp--manufacturing i{ background:#2f95ff; }
  .lm__item{ display:flex; gap:12px; justify-content:space-between; align-items:flex-start; padding:14px 12px 14px 0; border-bottom:1px solid #2c2c2c; cursor:pointer; }
  .lm__item:last-child{ border-bottom:0; }
  .lm__item h4{ margin:0 0 4px; font-size:15px; font-weight:600; line-height:1.3; color:#fff; }
  .lm__item p{ margin:0; font-size:13px; line-height:1.45; color:#8a8a8a; }
  .lm__item--store.is-sel h4{ color:#2ecc71; } .lm__item--office.is-sel h4{ color:#ff4d4f; } .lm__item--manufacturing.is-sel h4{ color:#2f95ff; }
  .lm .lm__item a{ flex:0 0 auto; padding:8px 12px; border-radius:8px; background:#fff; color:#000; font-size:12px; font-weight:600; text-decoration:none; white-space:nowrap; }

  /* map + glowing, breathing pins */
  .lm__map{ position:relative; width:min(100%,420px); aspect-ratio:405/455; margin:0 auto; }
  .lm__map img{ width:100%; height:100%; display:block; opacity:.85; }
  .lm__lines{ position:absolute; left:0; top:0; width:100%; height:100%; pointer-events:none; overflow:visible; }
  .lm .lm__pin{ position:absolute; width:14px !important; height:14px !important; min-width:0 !important; min-height:0 !important; padding:0 !important; margin:0; transform:translate(-50%,-50%); border-radius:50%; border:2px solid #fff !important; cursor:pointer; transition:transform .2s; appearance:none; -webkit-appearance:none; animation:lmb 2s ease-in-out infinite; animation-delay:var(--d,0s); }
  .lm__pin::before{ content:''; position:absolute; inset:-8px; border-radius:50%; }
  .lm__pin::after{ content:''; position:absolute; inset:-8px; border-radius:50%; border:2px solid currentColor; opacity:1; animation:lmr 2s ease-in-out infinite; animation-delay:var(--d,0s); }
  .lm__pin--office{ background:#ff4d4f !important; color:#ff4d4f; } .lm__pin--manufacturing{ background:#2f95ff !important; color:#2f95ff; } .lm__pin--store{ background:#2ecc71 !important; color:#2ecc71; }
  .lm .lm__pin.is-sel{ transform:translate(-50%,-50%) scale(1.25); z-index:2; }
  .lm__pin.is-sel::after{ inset:-9px; animation-duration:1.4s; }
  @keyframes lmb{ 0%,100%{ box-shadow:0 0 6px 1px currentColor; } 50%{ box-shadow:0 0 18px 6px currentColor; } }
  @keyframes lmr{ 0%,100%{ transform:scale(.85); } 50%{ transform:scale(1.25); } }

  .lm__tip{ display:none; }
  @media (hover:hover) and (pointer:fine){
    .lm__tip{ display:block; position:absolute; z-index:30; width:230px; padding:12px 14px; border-radius:12px; background:#fff; color:#0D1117; box-shadow:0 12px 28px rgba(0,0,0,.45); opacity:0; visibility:hidden; pointer-events:none; transition:opacity .15s; text-align:left; --tx:-50%; --ty:calc(-100% - 14px); transform:translate(var(--tx),var(--ty)); }
    .lm__tip--l{ --tx:-14px; } .lm__tip--r{ --tx:calc(-100% + 14px); } .lm__tip--bot{ --ty:14px; }
    .lm__tip small{ display:block; margin-bottom:4px; font-size:10px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#8B96A1; }
    .lm__tip strong{ display:block; margin-bottom:3px; font-size:14px; line-height:1.25; font-weight:600; color:#0D1117; }
    .lm__tip em{ display:block; font-style:normal; font-size:12px; line-height:1.4; color:#5C6874; }
    .lm__pin:hover + .lm__tip, .lm__pin:focus-visible + .lm__tip{ opacity:1; visibility:visible; }
  }
  @media(prefers-reduced-motion:reduce){ .lm .lm__pin, .lm__pin::after{ animation:none; } }

  /* tablet + mobile: title, map, buttons, then card/list */
  @media(max-width:900px){
    .lm{ padding:32px max(20px,env(safe-area-inset-right)) 36px max(20px,env(safe-area-inset-left)); }
    .lm__wrap{ display:flex; flex-direction:column; gap:0; }
    .lm__side{ display:contents; }
    .lm__head{ order:1; } .lm__map{ order:2; width:min(100%,330px); margin:6px auto 18px; } .lm__ctl{ order:3; } .lm__out{ order:4; }
    .lm__news{ margin-top:26px; padding:22px 20px; }
    .lm__newsin{ flex-direction:column; align-items:stretch; gap:18px; } .lm__form{ max-width:none; flex:none; }
  }
  @media(max-width:600px){
    .lm__chips{ display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:14px; }
    .lm .lm__chip{ justify-content:center; text-align:center; gap:7px; padding:13px 8px; font-size:14px; }
    .lm .lm__all{ grid-column:1 / -1; padding:14px; font-size:15px; }
    .lm__info{ padding:20px; min-height:136px; }
    .lm__info h3{ font-size:17px; margin-bottom:8px; } .lm__info p{ font-size:14.5px; }
    .lm .lm__gm{ width:100%; justify-content:center; margin-top:14px; padding:13px; }
    .lm__list{ max-height:none; padding:2px 16px; }
    .lm__item{ flex-direction:column; gap:12px; padding:16px 0; }
    .lm .lm__item a{ width:100%; text-align:center; padding:11px; }
    .lm .lm__pin{ width:12px !important; height:12px !important; }
    .lm__newstxt h2{ font-size:20px; }
    .lm__row{ flex-direction:column; }
    .lm__row input[type=email]{ font-size:16px; padding:15px 20px; } .lm__row button{ padding:15px !important; }
  }
</style>

<script>
(function(){
  var root = document.getElementById('lm-{{ section.id }}'); if(!root) return;
  var map = root.querySelector('.lm__map');
  var pins = [].slice.call(root.querySelectorAll('.lm__pin'));
  var chips = [].slice.call(root.querySelectorAll('.lm__chip[data-kind]'));
  var info = root.querySelector('.lm__info'), list = root.querySelector('.lm__list'), allBtn = root.querySelector('.lm__all');
  if(!info || !list || !allBtn || !pins.length || !map) return;
  var nameEl = info.querySelector('[data-name]'), addrEl = info.querySelector('[data-addr]'), gm = info.querySelector('[data-gm]');
  var kind = null, cur = 0, mode = 'card', items = [];
  var d0 = root.dataset;

  /* ---- breathing: stagger each pin ---- */
  pins.forEach(function(p, i){ p.style.setProperty('--d', (i * 0.45) + 's'); });

  /* ---- spread out overlapping pins, keep a thin line to the true spot ---- */
  var NS = 'http://www.w3.org/2000/svg';
  var svg = document.createElementNS(NS, 'svg');
  svg.setAttribute('class', 'lm__lines');
  map.insertBefore(svg, pins[0]);
  var base = pins.map(function(p){ return { x: parseFloat(p.style.left), y: parseFloat(p.style.top) }; });
  function layout(){
    var W = map.clientWidth, H = map.clientHeight; if(!W || !H) return;
    var min = pins[0].offsetWidth + 16, n = pins.length, i, j, k;
    var t = base.map(function(b){ return { x: b.x / 100 * W, y: b.y / 100 * H }; });
    var d = t.map(function(o, idx){ return { x: o.x + Math.cos(idx * 2.4) * 0.5, y: o.y + Math.sin(idx * 2.4) * 0.5 }; });
    for(k = 0; k < 120; k++){
      for(i = 0; i < n; i++){
        for(j = i + 1; j < n; j++){
          var dx = d[j].x - d[i].x, dy = d[j].y - d[i].y, dist = Math.sqrt(dx * dx + dy * dy) || 0.01;
          if(dist < min){
            var push = (min - dist) / 2, ux = dx / dist, uy = dy / dist;
            d[i].x -= ux * push; d[i].y -= uy * push;
            d[j].x += ux * push; d[j].y += uy * push;
          }
        }
      }
      for(i = 0; i < n; i++){
        d[i].x += (t[i].x - d[i].x) * 0.03; d[i].y += (t[i].y - d[i].y) * 0.03;
        d[i].x = Math.max(8, Math.min(W - 8, d[i].x)); d[i].y = Math.max(8, Math.min(H - 8, d[i].y));
      }
    }
    var s = '';
    pins.forEach(function(p, idx){
      var tip = p.nextElementSibling;
      p.style.left = d[idx].x + 'px'; p.style.top = d[idx].y + 'px';
      if(tip && tip.classList.contains('lm__tip')){ tip.style.left = d[idx].x + 'px'; tip.style.top = d[idx].y + 'px'; }
      var moved = Math.sqrt(Math.pow(d[idx].x - t[idx].x, 2) + Math.pow(d[idx].y - t[idx].y, 2));
      if(moved > 3){
        s += '<line x1="' + t[idx].x + '" y1="' + t[idx].y + '" x2="' + d[idx].x + '" y2="' + d[idx].y + '" stroke="rgba(255,255,255,.55)" stroke-width="1"/>';
        s += '<circle cx="' + t[idx].x + '" cy="' + t[idx].y + '" r="2.5" fill="#fff"/>';
      }
    });
    svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
    svg.innerHTML = s;
  }
  layout();
  var rt; function relayout(){ clearTimeout(rt); rt = setTimeout(layout, 80); }
  if(window.ResizeObserver){ new ResizeObserver(relayout).observe(map); } else { window.addEventListener('resize', relayout); }

  /* ---- build the "all locations" list from the pins ---- */
  function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  var labels = { store: d0.lStore, office: d0.lOffice, manufacturing: d0.lMfg };
  var html = '';
  ['store','office','manufacturing'].forEach(function(k){
    var idx = [];
    pins.forEach(function(p, i){ if(p.dataset.kind === k) idx.push(i); });
    if(!idx.length) return;
    html += '<div class="lm__grp lm__grp--' + k + '"><i></i>' + esc(labels[k]) + (idx.length > 1 ? ' (' + idx.length + ')' : '') + '</div>';
    idx.forEach(function(i){
      var p = pins[i];
      html += '<div class="lm__item lm__item--' + k + '" data-i="' + i + '" role="button" tabindex="0"><div><h4>' + esc(p.dataset.name) + '</h4><p>' + esc(p.dataset.addr) + '</p></div><a href="' + esc(p.dataset.url) + '" target="_blank" rel="noopener">Directions &#8599;</a></div>';
    });
  });
  list.innerHTML = html;
  [].slice.call(list.querySelectorAll('.lm__item')).forEach(function(el){
    var i = +el.dataset.i; items[i] = el;
    el.addEventListener('click', function(e){ if(e.target.closest('a')) return; select(i, false); });
    el.addEventListener('keydown', function(e){ if((e.key === 'Enter' || e.key === ' ') && !e.target.closest('a')){ e.preventDefault(); select(i, false); } });
  });

  /* ---- modes: single card <-> all list ---- */
  function setMode(m){
    mode = m;
    info.classList.toggle('lm--hide', m === 'list');
    list.classList.toggle('is-open', m === 'list');
    allBtn.classList.toggle('is-on', m === 'list');
    allBtn.setAttribute('aria-expanded', m === 'list' ? 'true' : 'false');
    allBtn.textContent = (m === 'list' ? '\u2715 ' + d0.lHide : '\u2630 ' + d0.lShow);
    chips.forEach(function(c){ c.classList.toggle('is-on', m === 'card' && c.dataset.kind === kind); });
  }

  /* ---- selection ---- */
  function select(i, user, fromPin){
    var pin = pins[i]; if(!pin) return;
    cur = i; kind = pin.dataset.kind;
    if(fromPin && mode === 'list') setMode('card');
    info.classList.add('is-sw');
    setTimeout(function(){ nameEl.textContent = pin.dataset.name; addrEl.textContent = pin.dataset.addr; gm.href = pin.dataset.url; info.classList.remove('is-sw'); }, 120);
    pins.forEach(function(p, j){ p.classList.toggle('is-sel', j === i); p.setAttribute('aria-pressed', j === i ? 'true' : 'false'); });
    items.forEach(function(el, j){ if(el) el.classList.toggle('is-sel', j === i); });
    chips.forEach(function(c){ c.classList.toggle('is-on', mode === 'card' && c.dataset.kind === kind); });
    if(user && window.matchMedia('(max-width:900px)').matches){
      var r = info.getBoundingClientRect();
      if(r.top < 0 || r.bottom > window.innerHeight){ info.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion:reduce)').matches ? 'auto' : 'smooth', block:'nearest' }); }
    }
  }

  pins.forEach(function(p, i){ p.addEventListener('click', function(){ select(i, true, true); }); });
  chips.forEach(function(c){
    if(!pins.some(function(p){ return p.dataset.kind === c.dataset.kind; })) c.style.display = 'none';
    c.addEventListener('click', function(){
      var f = pins.filter(function(p){ return p.dataset.kind === c.dataset.kind; })[0];
      if(f) select(pins.indexOf(f), true, true);
    });
  });
  allBtn.addEventListener('click', function(){
    if(mode === 'list'){ setMode('card'); select(cur, false); }
    else { setMode('list'); }
  });

  var first = chips.filter(function(c){ return c.style.display !== 'none'; })[0];
  setMode('card');
  select(first ? pins.indexOf(pins.filter(function(p){ return p.dataset.kind === first.dataset.kind; })[0]) : 0);
  document.addEventListener('shopify:block:select', function(e){ if(!root.contains(e.target)) return; var i = pins.indexOf(e.target); if(i > -1) select(i, false, true); });
})();
</script>

