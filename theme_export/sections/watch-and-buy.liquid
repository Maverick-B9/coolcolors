<!-- /sections/watch-and-buy.liquid — upload a video OR paste an Instagram Reel / YouTube Shorts link -->
<style>
  .social-section{ padding:56px 20px; background:#fff; color:#191919; overflow-x:clip; }
  .social-section, .social-section *, .social-modal, .social-modal * { box-sizing:border-box; font-family:'Poppins','Inter',system-ui,sans-serif; }
  .social-inner{ max-width:1300px; margin:0 auto; position:relative; }
  .social-header{ display:flex; justify-content:center; margin-bottom:32px; }
  .social-title{ font-size:28px; font-weight:600; color:#191919; margin:0; text-align:center; }
  .social-track{ position:relative; }
  .social-grid{ display:flex; align-items:stretch; gap:16px; overflow-x:auto; overflow-y:hidden; -webkit-overflow-scrolling:touch; cursor:grab; padding-bottom:8px; scrollbar-width:none; }
  .social-grid:active{ cursor:grabbing; } .social-grid::-webkit-scrollbar{ display:none; }

  /* desktop: 4 full cards + the 5th peeking */
  .social-item{ flex:0 0 calc((100% - 64px) / 4.3) !important; width:calc((100% - 64px) / 4.3) !important; max-width:calc((100% - 64px) / 4.3) !important; min-width:0 !important; display:flex; }

  .social-card{ width:100%; display:flex; flex-direction:column; background:#18181a; border:1px solid #2c2c2f; border-radius:18px; overflow:hidden; color:#fff; }
  .social-media{ position:relative; flex:none; width:100%; aspect-ratio:9/16; background:#000; cursor:pointer; overflow:hidden; }
  .social-media .social-video, .social-media .social-cover{ position:absolute !important; inset:0; width:100% !important; height:100% !important; max-width:none !important; object-fit:cover; display:block; }
  .social-embed-ph{ position:absolute; inset:0; display:grid; place-items:center; background:linear-gradient(160deg,#833AB4,#FD1D1D 55%,#FCB045); color:#fff; }
  .social-brand{ position:absolute; top:10px; left:10px; z-index:3; background:rgba(0,0,0,.55); color:#fff; font-size:10px; letter-spacing:.12em; text-transform:uppercase; padding:5px 10px; border-radius:9px; }
  .play-btn{ position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:52px; height:52px; border-radius:50%; background:rgba(255,255,255,.18); border:1px solid rgba(255,255,255,.4); backdrop-filter:blur(6px); display:flex; align-items:center; justify-content:center; z-index:2; color:#fff; font-size:16px; }
  .play-btn::after{ content:'▶'; margin-left:4px; }
  .social-pill{ position:absolute; left:8px; right:8px; bottom:8px; z-index:3; display:flex; gap:8px; align-items:center; padding:7px; border-radius:12px; background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.2); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); min-width:0; }
  .social-pill img{ width:34px; height:34px; border-radius:8px; object-fit:cover; flex:none; }
  .social-pill-text{ min-width:0; display:flex; flex-direction:column; gap:2px; }
  .social-pill-title{ font-size:11px; font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin:0; }
  .social-pill-price{ font-size:10px; color:#d0d0d0; }

  .social-info{ flex:1; padding:12px; display:flex; flex-direction:column; gap:8px; min-width:0; }
  .social-product-title{ font-size:14px; font-weight:500; color:#fff; text-decoration:none; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin:0; display:block; }
  .social-product-price{ display:flex; align-items:center; gap:7px; flex-wrap:wrap; }
  .social-price{ font-size:16px; font-weight:600; color:#fff; }
  .social-compare-price{ font-size:12px; font-weight:400; color:#7d7d82; text-decoration:line-through; }
  .social-discount-badge{ background:rgba(200,255,58,.12); color:#c8ff3a; font-size:10px; font-weight:500; padding:3px 7px; border-radius:8px; letter-spacing:.02em; }
  .social-acts{ display:flex; gap:8px; margin-top:auto; }
  .social-add-btn{ flex:1; height:42px; border:0; border-radius:11px; background:#f1ece4; color:#111; font-size:13px; font-weight:500; cursor:pointer; }
  .social-add-btn:disabled{ background:#3a3a3d; color:#8a8a8f; cursor:not-allowed; }
  .social-chev{ width:42px; height:42px; flex:none; border-radius:11px; background:#27272a; border:1px solid #2c2c2f; color:#aaa; cursor:pointer; display:flex; align-items:center; justify-content:center; padding:0; }
  .social-chev svg{ transition:transform .2s; } .social-chev[aria-expanded="true"] svg{ transform:rotate(180deg); }
  .social-variants{ display:none; }
  .social-variants.open{ display:block; }
  .social-variants select{ width:100%; height:40px; border-radius:10px; background:#27272a; color:#fff; border:1px solid #3a3a3d; padding:0 10px; font-size:13px; }

  .social-nav{ position:absolute; top:42%; transform:translateY(-50%); width:42px; height:42px; border-radius:50%; background:#191919; color:#fff; border:none; cursor:pointer; z-index:5; display:flex; align-items:center; justify-content:center; box-shadow:0 4px 12px rgba(0,0,0,.25); font-size:18px; padding:0; }
  .social-nav.prev{ left:-8px; } .social-nav.next{ right:-8px; }

  /* =====================================================
     Reel viewer (popup): swipe left/right, neighbours peek
     ===================================================== */
  .social-modal{
    --u:1vh; --gap:12px;
    --th:min(calc(var(--u) * 100 - 100px - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px)), 760px);
    --sw:min(78vw, calc(var(--th) * 9 / 16));
    display:none; position:fixed; inset:0; z-index:1000; flex-direction:column; align-items:stretch;
    background:rgba(8,8,10,.96); color:#fff;
    padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
  }
  @supports (height:100dvh){ .social-modal{ --u:1dvh; } }
  .social-modal.open{ display:flex; }

  .sm-top{ position:relative; flex:none; padding:14px 16px 10px; }
  .sm-bars{ display:flex; gap:4px; width:var(--sw); margin:0 auto; }
  .sm-bars i{ flex:1; height:3px; border-radius:2px; background:rgba(255,255,255,.28); overflow:hidden; position:relative; }
  .sm-bars i::after{ content:""; position:absolute; inset:0; background:#fff; transform:scaleX(0); transform-origin:left; transition:transform .3s; }
  .sm-bars i.on::after{ transform:scaleX(1); }
  .social-modal-close{ position:absolute; top:calc(6px + env(safe-area-inset-top,0px)); right:8px; width:40px; height:40px; border-radius:50%; background:transparent; border:none; color:#fff; font-size:28px; line-height:1; cursor:pointer; z-index:1010; display:flex; align-items:center; justify-content:center; padding:0; }

  .sm-track{ position:relative; flex:1; min-height:0; width:100%; max-width:1000px; margin:0 auto; display:flex; align-items:center; gap:var(--gap); overflow-x:auto; overflow-y:hidden; scroll-snap-type:x mandatory; scrollbar-width:none; -webkit-overflow-scrolling:touch; overscroll-behavior-x:contain; }
  .sm-track::-webkit-scrollbar{ display:none; }
  .sm-track::before, .sm-track::after{ content:""; flex:0 0 calc(50% - var(--sw) / 2 - var(--gap)); }

  .sm-slide{ flex:0 0 var(--sw); width:var(--sw); aspect-ratio:9/16; position:relative; scroll-snap-align:center; scroll-snap-stop:always; border-radius:22px; overflow:hidden; background:#000; transform:scale(.88); opacity:.5; transition:transform .35s cubic-bezier(.2,.8,.2,1), opacity .3s; user-select:none; -webkit-user-select:none; -webkit-touch-callout:none; touch-action:pan-x; }
  .sm-slide.active{ transform:none; opacity:1; }
  .sm-poster, .sm-player{ position:absolute; inset:0; }
  .sm-poster > *{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
  .sm-ph{ background:linear-gradient(160deg,#833AB4,#FD1D1D 55%,#FCB045); }
  .sm-player{ z-index:1; }
  .sm-player video{ width:100%; height:100%; object-fit:cover; display:block; cursor:pointer; }
  .sm-player iframe{ width:100%; height:100%; border:0; display:block; background:#fff; }
  /* link reels: the iframe swallows touches, so the edges stay swipeable */
  .sm-edge{ position:absolute; top:0; bottom:0; width:14%; z-index:2; touch-action:pan-x; }
  .sm-edge.l{ left:0; } .sm-edge.r{ right:0; }
  .sm-shade{ position:absolute; left:0; right:0; bottom:0; height:55%; background:linear-gradient(transparent,rgba(0,0,0,.78)); z-index:2; pointer-events:none; }

  .sm-who{ position:absolute; top:12px; left:12px; z-index:4; display:flex; align-items:center; gap:8px; font-size:12px; font-weight:500; text-shadow:0 1px 3px rgba(0,0,0,.5); pointer-events:none; }
  .sm-av{ width:30px; height:30px; border-radius:50%; padding:2px; background:conic-gradient(#feda75,#fa7e1e,#d62976,#962fbf,#feda75); flex:none; }
  .sm-av b{ width:100%; height:100%; border-radius:50%; background:#111; border:2px solid #111; font-size:11px; font-weight:600; display:grid; place-items:center; }

  /* controls only show on the active reel */
  .sm-mute, .sm-rail, .sm-prod{ opacity:0; pointer-events:none; transition:opacity .25s .1s; }
  .sm-slide.active .sm-mute, .sm-slide.active .sm-rail, .sm-slide.active .sm-prod{ opacity:1; pointer-events:auto; }

  .sm-mute{ position:absolute; top:10px; right:10px; z-index:5; width:34px; height:34px; border-radius:50%; border:0; background:rgba(0,0,0,.4); color:#fff; display:grid; place-items:center; cursor:pointer; padding:0; }
  .sm-mute svg{ width:18px; height:18px; display:block; }
  .sm-mute .o{ display:none; }
  .social-modal.is-muted .sm-mute .o{ display:block; }
  .social-modal.is-muted .sm-mute .w{ display:none; }
  .sm-slide.is-embed .sm-mute{ display:none; }

  .sm-rail{ position:absolute; right:10px; bottom:150px; z-index:4; display:flex; flex-direction:column; align-items:center; gap:18px; }
  .sm-slide.no-prod .sm-rail{ bottom:24px; }
  .sm-act{ background:none; border:0; color:#fff; display:flex; flex-direction:column; align-items:center; gap:3px; font-size:11px; font-weight:500; text-decoration:none; cursor:pointer; padding:0; text-shadow:0 1px 3px rgba(0,0,0,.6); }
  .sm-act svg{ width:28px; height:28px; display:block; filter:drop-shadow(0 1px 3px rgba(0,0,0,.45)); }
  .sm-act.wa svg{ color:#25d366; }
  .sm-heart path{ fill:none; stroke:#fff; stroke-width:2; stroke-linejoin:round; transition:fill .15s, stroke .15s; }
  .sm-act.liked .sm-heart path{ fill:#ff3040; stroke:#ff3040; }
  .sm-act.liked .sm-heart{ animation:smPop .35s cubic-bezier(.3,1.8,.5,1); }
  @keyframes smPop{ 0%{ transform:scale(.6); } 100%{ transform:scale(1); } }

  .sm-burst{ position:absolute; left:50%; top:50%; width:96px; height:96px; margin:-48px 0 0 -48px; z-index:6; pointer-events:none; opacity:0; filter:drop-shadow(0 4px 14px rgba(0,0,0,.35)); }
  .sm-burst.go{ animation:smBurst .8s ease-out; }
  @keyframes smBurst{ 0%{ opacity:0; transform:scale(.3) rotate(-12deg); } 25%{ opacity:1; transform:scale(1.15) rotate(6deg); } 60%{ opacity:1; transform:scale(1); } 100%{ opacity:0; transform:scale(1.2) translateY(-30px); } }

  .sm-prod{ position:absolute; left:10px; right:10px; bottom:10px; z-index:4; background:rgba(24,24,26,.9); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); border:1px solid rgba(255,255,255,.14); border-radius:16px; padding:10px; display:flex; flex-direction:column; gap:10px; }
  .sm-prow{ display:flex; align-items:center; gap:10px; min-width:0; }
  .sm-prow img{ width:42px; height:52px; border-radius:9px; object-fit:cover; flex:none; display:block; }
  .sm-pinfo{ flex:1; min-width:0; }
  .sm-ptitle{ display:block; font-size:13px; font-weight:500; color:#fff; text-decoration:none; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .sm-pprice{ display:flex; align-items:baseline; gap:8px; margin-top:3px; flex-wrap:wrap; }
  .sm-pprice .social-price{ font-size:15px; }
  .social-modal .sm-add{ position:static !important; display:flex !important; align-items:center; justify-content:center; width:100% !important; height:40px !important; min-height:0 !important; margin:0 !important; padding:0 14px !important; float:none !important; transform:none !important; background:#f1ece4; color:#111; border:none; border-radius:11px; font-size:13px; font-weight:500; line-height:1; cursor:pointer; white-space:nowrap; }
  .social-modal .sm-add:active{ transform:scale(.97) !important; }
  .social-modal .sm-add:disabled{ background:#3a3a3d; color:#8a8a8f; cursor:not-allowed; }

  .sm-hint{ flex:none; padding:8px 0 12px; text-align:center; font-size:11px; color:#9a9aa0; transition:opacity .4s; pointer-events:none; }
  .sm-hint.hide{ opacity:0; }

  /* desktop arrows */
  .social-modal-nav{ display:none; position:absolute; top:50%; margin-top:-22px; width:44px; height:44px; border-radius:50%; background:#fff; color:#191919; border:none; font-size:24px; line-height:1; cursor:pointer; align-items:center; justify-content:center; z-index:1010; box-shadow:0 4px 12px rgba(0,0,0,.3); padding:0; }
  .social-modal-nav.prev{ left:max(16px, calc(50% - 484px)); }
  .social-modal-nav.next{ right:max(16px, calc(50% - 484px)); }
  @media (hover:hover) and (min-width:769px){
    .social-modal-nav{ display:flex; }
    .sm-hint{ visibility:hidden; }
  }

  /* share sheet */
  .sm-scrim{ position:absolute; inset:0; background:rgba(0,0,0,.6); opacity:0; pointer-events:none; transition:opacity .25s; z-index:1020; }
  .sm-scrim.open{ opacity:1; pointer-events:auto; }
  .sm-sheet{ position:absolute; left:50%; bottom:0; width:100%; max-width:440px; transform:translate(-50%,100%); background:#18181a; border-radius:22px 22px 0 0; padding:10px 18px calc(22px + env(safe-area-inset-bottom,0px)); z-index:1030; transition:transform .32s cubic-bezier(.2,.8,.2,1); }
  .sm-sheet.open{ transform:translate(-50%,0); }
  .sm-grab{ width:38px; height:4px; border-radius:2px; background:rgba(255,255,255,.25); margin:0 auto 14px; }
  .sm-sheet-title{ margin:0 0 16px; font-size:15px; font-weight:600; text-align:center; color:#fff; }
  .sm-apps{ display:grid; grid-template-columns:repeat(4,1fr); gap:14px 4px; }
  .sm-app{ background:none; border:0; color:#fff; font-size:11px; display:flex; flex-direction:column; align-items:center; gap:7px; text-decoration:none; cursor:pointer; padding:0; }
  .sm-app span{ width:54px; height:54px; border-radius:50%; display:grid; place-items:center; font-size:22px; font-weight:600; }
  .sm-app svg{ width:24px; height:24px; }
  .sm-toast{ position:absolute; left:50%; top:calc(56px + env(safe-area-inset-top,0px)); transform:translate(-50%,-8px); background:rgba(255,255,255,.96); color:#111; font-size:12px; font-weight:500; padding:8px 14px; border-radius:20px; opacity:0; pointer-events:none; transition:opacity .2s, transform .2s; z-index:1040; white-space:nowrap; }
  .sm-toast.show{ opacity:1; transform:translate(-50%,0); }

  @media (prefers-reduced-motion:reduce){
    .sm-slide, .sm-sheet, .sm-scrim, .sm-bars i::after{ transition:none; }
    .sm-burst.go{ animation-duration:.01s; }
  }

  @media(max-width:1100px){
    .social-item{ flex:0 0 calc((100% - 32px) / 3.3) !important; width:calc((100% - 32px) / 3.3) !important; max-width:calc((100% - 32px) / 3.3) !important; }
  }

  /* ---------- Mobile: grid cards ---------- */
  @media(max-width:768px){
    .social-section{ padding:28px 0 14px; }
    .social-title{ font-size:22px; }
    .social-header{ margin-bottom:18px; padding:0 16px; }
    .social-grid{ gap:12px; padding:0 20px 8px; }
    .social-item{ flex:0 0 min(60vw, 270px) !important; width:min(60vw, 270px) !important; max-width:min(60vw, 270px) !important; }
    .social-card{ border-radius:16px; }
    .social-brand{ top:8px; left:8px; font-size:9px; padding:4px 8px; border-radius:8px; }
    .play-btn{ width:44px; height:44px; font-size:13px; }
    .social-pill{ left:6px; right:6px; bottom:6px; gap:7px; padding:6px; border-radius:11px; }
    .social-pill img{ width:30px; height:30px; border-radius:7px; }
    .social-pill-title{ font-size:10.5px; } .social-pill-price{ font-size:9.5px; }
    .social-info{ padding:10px; gap:7px; }
    .social-product-title{ font-size:13px; }
    .social-price{ font-size:15px; } .social-compare-price{ font-size:11px; } .social-discount-badge{ font-size:9.5px; padding:2px 6px; }
    .social-add-btn{ height:38px; font-size:12.5px; border-radius:10px; }
    .social-chev{ width:38px; height:38px; border-radius:10px; }
    .social-variants select{ height:38px; }
    .social-nav{ width:34px; height:34px; font-size:16px; }
    .social-nav.prev{ display:flex; left:6px; right:auto; }
    .social-nav.next{ right:6px; left:auto; }
  }
</style>

{%- liquid
  assign wb_count = 0
  for b in section.blocks
    if b.settings.video != blank or b.settings.reel_url != blank
      assign wb_count = wb_count | plus: 1
    endif
  endfor
-%}
{%- if wb_count == 0 -%}
  {%- if request.design_mode -%}
    <div class="social-section" style="text-align:center;color:#8a8a8a;padding:40px 20px;"><p style="margin:0;font-size:14px;">Watch and Buy: add a "Video / Reel" block (video or reel link) to show this section. It stays hidden on the live store until then.</p></div>
  {%- endif -%}
{%- else -%}
<section class="social-section">
  <div class="social-inner">
    <div class="social-header">
      <h2 class="social-title">{{ section.settings.heading }}</h2>
    </div>
    <div class="social-track">
    <button type="button" class="social-nav prev" aria-label="Scroll left" data-social-scroll="-1">&#8249;</button>
    <button type="button" class="social-nav next" aria-label="Scroll right" data-social-scroll="1">&#8250;</button>
    <div class="social-grid">
      {% for block in section.blocks %}
        {% if block.settings.video != blank or block.settings.reel_url != blank %}
          {% assign social_product = block.settings.product %}
          {% if social_product == blank and section.settings.use_current_product and template.name == 'product' %}{% assign social_product = product %}{% endif %}
          {% assign social_variant = social_product.selected_or_first_available_variant %}
          {% assign social_likes = block.settings.likes | default: 0 %}
          <div class="social-item" data-likes="{{ social_likes }}" {{ block.shopify_attributes }}>
            <article class="social-card">
              <div class="social-media"{% if block.settings.video == blank %} data-embed="{{ block.settings.reel_url | escape }}"{% endif %}>
                {% if block.settings.video != blank %}
                  {{
                    block.settings.video
                    | video_tag:
                      autoplay: false,
                      loop: true,
                      muted: true,
                      controls: false,
                      playsinline: true,
                      preload: 'metadata',
                      class: 'social-video preview-video'
                  }}
                {% else %}
                  {% if block.settings.cover_image != blank %}
                    <img class="social-cover" src="{{ block.settings.cover_image | image_url: width: 700 }}" alt="{{ social_product.title | default: 'Reel' | escape }}" loading="lazy" width="{{ block.settings.cover_image.width }}" height="{{ block.settings.cover_image.height }}">
                  {% else %}
                    <div class="social-embed-ph" data-ph>
                      <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
                    </div>
                  {% endif %}
                {% endif %}
                {% if section.settings.brand_label != blank %}<span class="social-brand">{{ section.settings.brand_label }}</span>{% endif %}
                <div class="play-btn"></div>
                {% if social_product != blank %}
                  <div class="social-pill">
                    {% if social_product.featured_image %}<img src="{{ social_product.featured_image | image_url: width: 120 }}" alt="" loading="lazy" width="38" height="38">{% endif %}
                    <div class="social-pill-text">
                      <p class="social-pill-title">{{ social_product.title }}</p>
                      <span class="social-pill-price">{{ social_product.price | money }}</span>
                    </div>
                  </div>
                {% endif %}
              </div>

              {% if social_product != blank %}
                <div
                  class="social-info social-product-link"
                  data-title="{{ social_product.title | escape }}"
                  data-url="{{ social_product.url }}"
                  data-image="{{ social_product.featured_image | image_url: width: 200 }}"
                  data-price="{{ social_product.price | money }}"
                  data-compare-price="{% if social_product.compare_at_price > social_product.price %}{{ social_product.compare_at_price | money }}{% endif %}"
                  data-variant-id="{{ social_variant.id }}"
                  data-available="{{ social_variant.available }}"
                >
                  <a href="{{ social_product.url }}" class="social-product-title">{{ social_product.title }}</a>
                  <div class="social-product-price" data-card-price>
                    <span class="social-price" data-p>{{ social_variant.price | money }}</span>
                    <span class="social-compare-price" data-c{% unless social_variant.compare_at_price > social_variant.price %} hidden{% endunless %}>{% if social_variant.compare_at_price > social_variant.price %}{{ social_variant.compare_at_price | money }}{% endif %}</span>
                    <span class="social-discount-badge" data-d{% unless social_variant.compare_at_price > social_variant.price %} hidden{% endunless %}>{% if social_variant.compare_at_price > social_variant.price %}{{ social_variant.compare_at_price | minus: social_variant.price | times: 100.0 | divided_by: social_variant.compare_at_price | round }}% OFF{% endif %}</span>
                  </div>
                  <div class="social-acts">
                    <button type="button" class="social-add-btn" data-card-add data-variant-id="{{ social_variant.id }}"{% unless social_variant.available %} disabled{% endunless %}>{% if social_variant.available %}Add to Cart{% else %}Sold out{% endif %}</button>
                    {% if social_product.variants.size > 1 %}
                      <button type="button" class="social-chev" data-card-chev aria-label="Choose option" aria-expanded="false"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
                    {% endif %}
                  </div>
                  {% if social_product.variants.size > 1 %}
                    <div class="social-variants" data-card-variants>
                      <select aria-label="Option" data-card-select>
                        {% for v in social_product.variants %}
                          <option value="{{ v.id }}" data-price="{{ v.price | money }}" data-price-raw="{{ v.price }}" data-compare="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money }}{% endif %}" data-compare-raw="{{ v.compare_at_price }}" data-available="{{ v.available }}"{% if v.id == social_variant.id %} selected{% endif %}>{{ v.title }}{% unless v.available %} (Sold out){% endunless %}</option>
                        {% endfor %}
                      </select>
                    </div>
                  {% endif %}
                </div>
              {% endif %}
            </article>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    </div>
  </div>

  <div class="social-modal" id="socialModal-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Reels" data-brand="{{ section.settings.brand_label | escape }}" data-wa="{{ section.settings.whatsapp_number | strip | escape }}">
    <div class="sm-top">
      <div class="sm-bars" data-sm-bars></div>
      <button type="button" class="social-modal-close" aria-label="Close" data-social-close>&times;</button>
    </div>
    <button type="button" class="social-modal-nav prev" aria-label="Previous reel" data-social-prev>&#8249;</button>
    <button type="button" class="social-modal-nav next" aria-label="Next reel" data-social-next>&#8250;</button>
    <div class="sm-track" data-sm-track></div>
    <div class="sm-hint" data-sm-hint>Swipe left or right &middot; double-tap to like</div>

    <div class="sm-scrim" data-sm-scrim></div>
    <div class="sm-sheet" data-sm-sheet role="dialog" aria-label="Share">
      <div class="sm-grab"></div>
      <h3 class="sm-sheet-title">Share</h3>
      <div class="sm-apps">
        <a class="sm-app" data-share="whatsapp" href="#" target="_blank" rel="noopener"><span style="background:#25d366"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l1.9-5.4A8.4 8.4 0 1 1 21 11.5z"/></svg></span>WhatsApp</a>
        <a class="sm-app" data-share="facebook" href="#" target="_blank" rel="noopener"><span style="background:#1877f2">f</span>Facebook</a>
        <a class="sm-app" data-share="x" href="#" target="_blank" rel="noopener"><span style="background:#000;border:1px solid #3a3a3d">X</span>X</a>
        <button type="button" class="sm-app" data-share="copy"><span style="background:#27272a"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.1 0l3-3a5 5 0 0 0-7.1-7.1l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.1 0l-3 3A5 5 0 0 0 11 21.1l1.7-1.7"/></svg></span>Copy link</button>
      </div>
    </div>
    <div class="sm-toast" data-sm-toast></div>
  </div>
</section>
{%- endif -%}

<script>
(function(){
  function parseEmbed(url){
    if(!url) return null; var m;
    if((m = url.match(/instagram\.com\/(?:[^\/?#]+\/)?(reels?|p|tv)\/([A-Za-z0-9_-]+)/))) return { type:'instagram', src:'https://www.instagram.com/' + (m[1]==='p' ? 'p' : 'reel') + '/' + m[2] + '/embed/' };
    if((m = url.match(/(?:youtube\.com\/(?:shorts\/|watch\?v=|embed\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/))) return { type:'youtube', src:'https://www.youtube.com/embed/' + m[1] + '?autoplay=1&playsinline=1&rel=0', thumb:'https://img.youtube.com/vi/' + m[1] + '/hqdefault.jpg' };
    if(/\.(mp4|webm|mov)(\?|$)/i.test(url)) return { type:'file', src:url };
    return null;
  }

  /* 1240 -> 1.2K, 2500000 -> 2.5M */
  function fmtCount(n){
    n = n || 0;
    if(n >= 999950) return (Math.round(n / 100000) / 10).toString().replace(/\.0$/, '') + 'M';
    if(n >= 1000) return (Math.round(n / 100) / 10).toString().replace(/\.0$/, '') + 'K';
    return String(n);
  }
  function esc(s){ return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function absUrl(u){ if(u && u.charAt(0) === '/') return window.location.origin + u; return u; }

  function initSection(section){
    if(section.dataset.socialInit) return; section.dataset.socialInit = 'true';
    var slider = section.querySelector('.social-grid');
    if(!slider) return;
    var modal = section.querySelector('.social-modal');

    /* ---- infinite loop: duplicate the set once (before any handlers are attached) ---- */
    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var originals = Array.prototype.slice.call(slider.querySelectorAll('.social-item'));
    var N = originals.length;
    var loop = N >= 4 && !reduced;
    if(loop){
      originals.forEach(function(it){
        var c = it.cloneNode(true); c.setAttribute('data-clone', '1'); c.setAttribute('aria-hidden', 'true');
        slider.appendChild(c);
      });
    }
    function halfWidth(){
      var c = slider.querySelector('.social-item[data-clone]'), f = slider.querySelector('.social-item');
      return c && f ? c.offsetLeft - f.offsetLeft : 0;
    }

    /* YouTube thumbnails for link-based cards without a cover image */
    section.querySelectorAll('.social-media[data-embed]').forEach(function(card){
      var e = parseEmbed(card.dataset.embed), ph = card.querySelector('[data-ph]');
      if(e && e.type === 'youtube' && ph){ var img = new Image(); img.className = 'social-cover'; img.alt = ''; img.src = e.thumb; ph.replaceWith(img); }
    });

    /* ---- auto-slide ---- */
    var SPEED = 40, pos = 0, paused = false, last = null, rt = null, isDown = false, startX, scrollLeft, moved = false;
    function pause(){ paused = true; clearTimeout(rt); }
    function resume(d){ clearTimeout(rt); rt = setTimeout(function(){ paused = false; pos = slider.scrollLeft; last = null; }, d || 0); }
    function tick(ts){
      if(last === null) last = ts;
      var el = Math.min(ts - last, 100); last = ts;
      var half = loop ? halfWidth() : 0;
      if(loop && half > 0 && !paused && !isDown && !modal.classList.contains('open')){
        pos += SPEED * (el / 1000);
        while(pos >= half) pos -= half;
        slider.scrollLeft = pos;
      } else { pos = slider.scrollLeft; }
      requestAnimationFrame(tick);
    }
    if(loop) requestAnimationFrame(tick);

    slider.addEventListener('mouseenter', pause);
    slider.addEventListener('mouseleave', function(){ isDown = false; resume(); });
    slider.addEventListener('touchstart', pause, { passive:true });
    slider.addEventListener('touchend', function(){ resume(1200); });
    slider.addEventListener('touchcancel', function(){ resume(1200); });
    slider.addEventListener('wheel', function(){ pause(); resume(1500); }, { passive:true });

    /* arrows (step = distance between two cards, so any gap works) */
    section.querySelectorAll('[data-social-scroll]').forEach(function(b){
      b.addEventListener('click', function(){
        var dir = parseInt(b.dataset.socialScroll, 10);
        var all = slider.querySelectorAll('.social-item'), first = all[0], second = all[1];
        var step = first ? (second ? second.offsetLeft - first.offsetLeft : first.offsetWidth + 16) : 300;
        var half = loop ? halfWidth() : 0;
        pause();
        if(loop && half > 0){
          if(dir < 0 && slider.scrollLeft < step) slider.scrollLeft += half;
          if(dir > 0 && slider.scrollLeft + step > half * 2 - slider.clientWidth) slider.scrollLeft -= half;
        }
        slider.scrollBy({ left: step * dir, behavior:'smooth' });
        resume(1800);
      });
    });

    /* mouse drag */
    slider.addEventListener('mousedown', function(e){ isDown = true; moved = false; startX = e.pageX - slider.offsetLeft; scrollLeft = slider.scrollLeft; });
    window.addEventListener('mouseup', function(){ isDown = false; });
    slider.addEventListener('mousemove', function(e){ if(!isDown) return; var x = e.pageX - slider.offsetLeft; if(Math.abs(x - startX) > 4){ moved = true; e.preventDefault(); slider.scrollLeft = scrollLeft - (x - startX) * 1.5; } });

    if('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(en){ var v = en.target.querySelector('.preview-video'); if(!v) return; if(en.isIntersecting){ v.play().catch(function(){}); } else { v.pause(); } });
      }, { root: slider, threshold: 0.4 });
      section.querySelectorAll('.social-media').forEach(function(c){ io.observe(c); });
    } else { section.querySelectorAll('.preview-video').forEach(function(v){ v.play().catch(function(){}); }); }

    /* in-card variant picker + add to cart */
    section.querySelectorAll('.social-info').forEach(function(info){
      var chev = info.querySelector('[data-card-chev]'), panel = info.querySelector('[data-card-variants]'), sel = info.querySelector('[data-card-select]');
      var addBtn = info.querySelector('[data-card-add]');
      if(chev && panel){ chev.addEventListener('click', function(){ var o = panel.classList.toggle('open'); chev.setAttribute('aria-expanded', o ? 'true' : 'false'); }); }
      if(sel){
        sel.addEventListener('change', function(){
          var o = sel.options[sel.selectedIndex];
          var p = info.querySelector('[data-p]'), c = info.querySelector('[data-c]'), d = info.querySelector('[data-d]');
          p.textContent = o.dataset.price;
          var pr = parseFloat(o.dataset.priceRaw), cr = parseFloat(o.dataset.compareRaw);
          if(cr > pr){ c.textContent = o.dataset.compare; c.hidden = false; d.textContent = Math.round((cr - pr) * 100 / cr) + '% OFF'; d.hidden = false; } else { c.hidden = true; d.hidden = true; }
          var ok = o.dataset.available === 'true';
          addBtn.dataset.variantId = o.value; addBtn.disabled = !ok; addBtn.textContent = ok ? 'Add to Cart' : 'Sold out';
          info.dataset.variantId = o.value; info.dataset.price = o.dataset.price; info.dataset.comparePrice = o.dataset.compare; info.dataset.available = ok ? 'true' : 'false';
        });
      }
      if(addBtn) addBtn.addEventListener('click', addToCart);
    });

    /* =====================================================
       Reel viewer
       ===================================================== */
    var track = modal.querySelector('[data-sm-track]'), barsEl = modal.querySelector('[data-sm-bars]'), hintEl = modal.querySelector('[data-sm-hint]');
    var sheet = modal.querySelector('[data-sm-sheet]'), scrim = modal.querySelector('[data-sm-scrim]'), toastEl = modal.querySelector('[data-sm-toast]');
    var brand = (modal.dataset.brand || '').trim(), wa = (modal.dataset.wa || '').replace(/\D/g, '');
    var items = [], slides = [], idx = -1, isMuted = false, likedMap = {}, hinted = false;
    var settleT = null, tapT = null, toastT = null, lastTap = 0, raf = null;

    var HEART_D = 'M12 21s-7.5-4.6-9.6-9.3C.9 8.2 2.6 4.5 6.2 4.5c2.1 0 3.8 1.2 5.8 3.4 2-2.2 3.7-3.4 5.8-3.4 3.6 0 5.3 3.7 3.8 7.2C19.5 16.4 12 21 12 21z';
    var IC = {
      heart: '<svg class="sm-heart" viewBox="0 0 24 24"><path d="' + HEART_D + '"/></svg>',
      plane: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><path d="M22 3 9.5 10.5"/><path d="M22 3l-7 18-5.5-10.5L3 8z"/></svg>',
      wa: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l1.9-5.4A8.4 8.4 0 1 1 21 11.5z"/></svg>',
      mute: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path class="w" d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/><path class="o" d="M23 9l-6 6M17 9l6 6"/></svg>',
      burst: '<svg class="sm-burst" viewBox="0 0 24 24"><path fill="#ff3040" d="' + HEART_D + '"/></svg>'
    };

    function collect(){
      items = Array.prototype.map.call(section.querySelectorAll('.social-item:not([data-clone])'), function(item){
        var video = item.querySelector('.social-video'), card = item.querySelector('.social-media'), pe = item.querySelector('.social-info'), cover = item.querySelector('.social-cover');
        var src = video ? (video.currentSrc || (video.querySelector('source') && video.querySelector('source').src) || video.src) : '';
        var embed = card && card.dataset.embed ? parseEmbed(card.dataset.embed) : null;
        var kind = (embed && embed.type !== 'file') ? 'iframe' : ((src || (embed && embed.src)) ? 'video' : 'none');
        return {
          kind: kind,
          videoSrc: src || (embed && embed.src) || '',
          embed: embed,
          poster: (video && video.poster) ? video.poster : (cover ? cover.src : ''),
          likes: Math.max(0, parseInt(item.dataset.likes, 10) || 0),
          product: pe ? { title: pe.dataset.title, url: pe.dataset.url, image: pe.dataset.image, price: pe.dataset.price, comparePrice: pe.dataset.comparePrice, variantId: pe.dataset.variantId, available: pe.dataset.available === 'true' } : null
        };
      });
    }

    function waLink(it){
      var t = it.product && it.product.title ? 'Hi! I am interested in ' + it.product.title : 'Hi!';
      var u = it.product && it.product.url ? absUrl(it.product.url) : '';
      return 'https://wa.me/' + wa + '?text=' + encodeURIComponent((t + ' ' + u).trim());
    }

    function build(){
      track.innerHTML = ''; barsEl.innerHTML = '';
      var html = '', bars = '';
      items.forEach(function(it, i){
        var p = it.product, liked = !!likedMap[i];
        var poster = it.poster ? '<img src="' + esc(it.poster) + '" alt="" draggable="false">' : (it.kind === 'video' ? '<video src="' + esc(it.videoSrc) + '#t=0.1" muted playsinline preload="metadata"></video>' : '<div class="sm-ph"></div>');
        bars += '<i></i>';
        html += '<article class="sm-slide' + (it.kind === 'iframe' ? ' is-embed' : '') + (p && p.title ? '' : ' no-prod') + '" data-i="' + i + '">' +
          '<div class="sm-poster">' + poster + '</div><div class="sm-player"></div>' +
          (it.kind === 'iframe' ? '<span class="sm-edge l"></span><span class="sm-edge r"></span>' : '') +
          '<div class="sm-shade"></div>' +
          (brand ? '<div class="sm-who"><span class="sm-av"><b>' + esc(brand.charAt(0).toUpperCase()) + '</b></span>' + esc(brand) + '</div>' : '') +
          '<button type="button" class="sm-mute" aria-label="Toggle sound">' + IC.mute + '</button>' +
          IC.burst +
          '<div class="sm-rail">' +
            (wa ? '<a class="sm-act wa" href="' + esc(waLink(it)) + '" target="_blank" rel="noopener" aria-label="Talk to us">' + IC.wa + '<span>Chat</span></a>' : '') +
            '<button type="button" class="sm-act sm-like' + (liked ? ' liked' : '') + '" aria-label="Like">' + IC.heart + '<span class="sm-cnt">' + fmtCount(it.likes + (liked ? 1 : 0)) + '</span></button>' +
            '<button type="button" class="sm-act sm-share" aria-label="Share">' + IC.plane + '<span>Share</span></button>' +
          '</div>' +
          (p && p.title ?
            '<div class="sm-prod"><div class="sm-prow">' +
              (p.image ? '<a href="' + esc(p.url) + '"><img src="' + esc(p.image) + '" alt=""></a>' : '') +
              '<div class="sm-pinfo"><a class="sm-ptitle" href="' + esc(p.url) + '">' + esc(p.title) + '</a>' +
              '<div class="sm-pprice"><span class="social-price">' + esc(p.price || '') + '</span>' + (p.comparePrice ? '<span class="social-compare-price">' + esc(p.comparePrice) + '</span>' : '') + '</div></div>' +
            '</div><button type="button" class="sm-add" data-variant-id="' + esc(p.variantId || '') + '"' + (p.available ? '' : ' disabled') + '>' + (p.available ? 'Add to Cart' : 'Sold out') + '</button></div>'
          : '') +
        '</article>';
      });
      barsEl.innerHTML = bars; track.innerHTML = html;
      slides = Array.prototype.slice.call(track.querySelectorAll('.sm-slide'));
      track.querySelectorAll('.sm-add').forEach(function(b){ b.addEventListener('click', addToCart); });
    }

    /* ---- player: only the active reel loads a real video / iframe ---- */
    function unmount(s){
      var pl = s.querySelector('.sm-player'); if(!pl || !pl.firstChild) return;
      var v = pl.querySelector('video'); if(v){ v.pause(); v.removeAttribute('src'); v.load(); }
      pl.innerHTML = '';
    }
    function mount(i){
      var it = items[i], s = slides[i]; if(!it || !s || i !== idx) return;
      var pl = s.querySelector('.sm-player'); if(!pl || pl.firstChild) return;
      if(it.kind === 'iframe'){
        var f = document.createElement('iframe'); f.src = it.embed.src; f.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture'; f.allowFullscreen = true; f.setAttribute('scrolling', it.embed.type === 'instagram' ? 'yes' : 'no');
        pl.appendChild(f);
      } else if(it.kind === 'video'){
        var v = document.createElement('video'); v.src = it.videoSrc; v.playsInline = true; v.setAttribute('playsinline', ''); v.loop = true; v.muted = isMuted;
        pl.appendChild(v);
        v.play().catch(function(){ if(!v.muted){ v.muted = true; isMuted = true; paintMute(); v.play().catch(function(){}); } });
      }
    }
    function markActive(i){
      if(i === idx) return;
      var prev = idx; idx = i;
      slides.forEach(function(s, k){ s.classList.toggle('active', k === i); if(k !== i) unmount(s); });
      Array.prototype.forEach.call(barsEl.children, function(b, k){ b.classList.toggle('on', k <= i); });
      if(prev !== -1){ hinted = true; hintEl.classList.add('hide'); closeSheet(); }
      clearTimeout(settleT); settleT = setTimeout(function(){ mount(i); }, 140);
    }

    /* ---- swiping / navigation ---- */
    function goTo(i, smooth){
      var s = slides[i]; if(!s) return;
      var left = s.offsetLeft - (track.clientWidth - s.offsetWidth) / 2;
      if(smooth && track.scrollTo){ track.scrollTo({ left:left, behavior:'smooth' }); } else { track.scrollLeft = left; }
    }
    function step(d){
      if(idx < 0 || !slides.length) return;
      var n = idx + d; if(n < 0) n = slides.length - 1; if(n >= slides.length) n = 0;
      goTo(n, true);
    }
    track.addEventListener('scroll', function(){
      if(raf) return;
      raf = requestAnimationFrame(function(){
        raf = null; if(!slides.length) return;
        var c = track.scrollLeft + track.clientWidth / 2, best = 0, bd = 1e9;
        slides.forEach(function(s, k){ var d = Math.abs(s.offsetLeft + s.offsetWidth / 2 - c); if(d < bd){ bd = d; best = k; } });
        markActive(best);
      });
    }, { passive:true });

    /* ---- likes ---- */
    function setLike(i, v){
      likedMap[i] = v; var s = slides[i]; if(!s) return;
      var b = s.querySelector('.sm-like'), c = s.querySelector('.sm-cnt');
      b.classList.toggle('liked', v); c.textContent = fmtCount(items[i].likes + (v ? 1 : 0));
    }
    function burst(s){ var b = s.querySelector('.sm-burst'); if(!b) return; b.classList.remove('go'); void b.getBoundingClientRect(); b.classList.add('go'); }

    /* ---- sound ---- */
    function paintMute(){ modal.classList.toggle('is-muted', isMuted); }
    function toggleMute(){ isMuted = !isMuted; var v = track.querySelector('.sm-slide.active .sm-player video'); if(v) v.muted = isMuted; paintMute(); }

    /* ---- share: native sheet on phones, our own sheet elsewhere ---- */
    function toast(msg){ toastEl.textContent = msg; toastEl.classList.add('show'); clearTimeout(toastT); toastT = setTimeout(function(){ toastEl.classList.remove('show'); }, 1800); }
    function shareData(){
      var it = items[idx], p = it && it.product;
      return { url: p && p.url ? absUrl(p.url) : window.location.href, title: p && p.title ? p.title : document.title };
    }
    function copyLink(u){
      if(navigator.clipboard && navigator.clipboard.writeText) return navigator.clipboard.writeText(u);
      return new Promise(function(res, rej){
        var t = document.createElement('textarea'); t.value = u; t.style.position = 'fixed'; t.style.opacity = '0'; document.body.appendChild(t); t.select();
        var ok = false; try{ ok = document.execCommand('copy'); }catch(e){}
        document.body.removeChild(t); ok ? res() : rej();
      });
    }
    function openSheet(){
      var d = shareData(), enc = encodeURIComponent;
      sheet.querySelector('[data-share="whatsapp"]').href = 'https://wa.me/?text=' + enc(d.title + ' ' + d.url);
      sheet.querySelector('[data-share="facebook"]').href = 'https://www.facebook.com/sharer/sharer.php?u=' + enc(d.url);
      sheet.querySelector('[data-share="x"]').href = 'https://twitter.com/intent/tweet?text=' + enc(d.title) + '&url=' + enc(d.url);
      sheet.classList.add('open'); scrim.classList.add('open');
    }
    function closeSheet(){ sheet.classList.remove('open'); scrim.classList.remove('open'); }
    function doShare(){
      var d = shareData();
      var native = navigator.share && window.matchMedia && window.matchMedia('(pointer:coarse)').matches;
      if(native){ navigator.share({ title:d.title, text:d.title, url:d.url }).catch(function(err){ if(err && err.name !== 'AbortError') openSheet(); }); }
      else { openSheet(); }
    }
    scrim.addEventListener('click', closeSheet);
    sheet.addEventListener('click', function(e){
      var t = e.target.closest('[data-share]'); if(!t) return;
      if(t.dataset.share === 'copy'){ copyLink(shareData().url).then(function(){ toast('Link copied'); closeSheet(); }).catch(function(){ toast('Could not copy link'); }); }
      else { closeSheet(); }
    });

    /* ---- add to cart (unchanged behaviour) ---- */
    function addToCart(e){
      e.preventDefault(); var btn = e.currentTarget, id = btn.dataset.variantId; if(!id || btn.disabled) return;
      var orig = btn.textContent; btn.disabled = true; btn.textContent = 'Adding...';
      fetch('/cart/add.js', { method:'POST', headers:{ 'Content-Type':'application/json', Accept:'application/json' }, body: JSON.stringify({ id: id, quantity: 1 }) })
        .then(function(r){ return r.json(); })
        .then(function(d){ if(d.status) throw new Error(d.description || 'Unable to add'); btn.textContent = 'Added'; window.location.href = '/cart'; })
        .catch(function(){ btn.textContent = 'Error'; btn.disabled = false; setTimeout(function(){ btn.textContent = orig; }, 1500); });
    }

    /* ---- taps inside the viewer: peek -> centre, buttons, single tap = pause, double tap = like ---- */
    track.addEventListener('click', function(e){
      var s = e.target.closest('.sm-slide'); if(!s) return;
      var i = parseInt(s.dataset.i, 10);
      if(i !== idx){ goTo(i, true); return; }
      if(e.target.closest('a, .sm-add')) return;
      if(e.target.closest('.sm-mute')){ toggleMute(); return; }
      if(e.target.closest('.sm-like')){ setLike(i, !likedMap[i]); return; }
      if(e.target.closest('.sm-share')){ doShare(); return; }
      var now = Date.now();
      if(now - lastTap < 280){
        clearTimeout(tapT); lastTap = 0;
        if(!likedMap[i]) setLike(i, true);
        burst(s); return;
      }
      lastTap = now;
      var v = s.querySelector('.sm-player video');
      tapT = setTimeout(function(){ if(v){ if(v.paused){ v.play().catch(function(){}); } else { v.pause(); } } }, 280);
    });

    /* ---- open / close ---- */
    function open(index){
      collect(); var n = items.length; if(!n) return;
      var i = ((index % n) + n) % n;
      section.querySelectorAll('.social-video').forEach(function(v){ v.pause(); });
      build(); idx = -1;
      modal.classList.add('open'); document.body.style.overflow = 'hidden';
      paintMute(); closeSheet();
      if(hinted) hintEl.classList.add('hide'); else hintEl.classList.remove('hide');
      goTo(i, false);
      markActive(i); clearTimeout(settleT); mount(i);
    }
    function close(){
      modal.classList.remove('open'); document.body.style.overflow = ''; closeSheet();
      clearTimeout(settleT); clearTimeout(tapT);
      slides.forEach(unmount); track.innerHTML = ''; barsEl.innerHTML = ''; slides = []; idx = -1; last = null;
      section.querySelectorAll('.social-media').forEach(function(c){ var v = c.querySelector('.preview-video'); if(!v) return; var r = c.getBoundingClientRect(); if(r.right > 0 && r.left < window.innerWidth) v.play().catch(function(){}); });
    }

    section.querySelectorAll('.social-item').forEach(function(item, idx2){
      var card = item.querySelector('.social-media'); if(!card) return;
      card.addEventListener('click', function(){ if(moved){ moved = false; return; } open(idx2 % N); });
    });
    modal.querySelector('[data-social-close]').addEventListener('click', close);
    modal.querySelector('[data-social-prev]').addEventListener('click', function(){ step(-1); });
    modal.querySelector('[data-social-next]').addEventListener('click', function(){ step(1); });
    modal.addEventListener('click', function(e){ if(e.target === modal || e.target.classList.contains('sm-top')) close(); });
    document.addEventListener('keydown', function(e){
      if(!modal.classList.contains('open')) return;
      if(e.key === 'Escape'){ if(sheet.classList.contains('open')) closeSheet(); else close(); }
      if(e.key === 'ArrowLeft') step(-1);
      if(e.key === 'ArrowRight') step(1);
    });
  }
  function boot(){ document.querySelectorAll('.social-section').forEach(initSection); }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  document.addEventListener('shopify:section:load', boot);
})();
</script>

