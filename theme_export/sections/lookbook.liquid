{%- liquid
  assign title_parts = section.settings.title | split: '/'
  assign band_parts = section.settings.cta_text | split: '/'
  assign quote_parts = section.settings.quote | split: '/'

  assign block_total = section.blocks.size
  assign has_extra = false
  if block_total >= 5
    assign has_extra = true
  endif
  assign frame_total = block_total
  if has_extra
    assign frame_total = block_total | plus: 1
  endif
  assign fi = 0
-%}

{%- if section.settings.display_font -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&display=swap" rel="stylesheet">
{%- endif -%}

<section
  class="clb{% if section.settings.display_font %} clb--font{% else %} clb--themefont{% endif %}"
  id="clb-{{ section.id }}"
  style="--clb-bg:{{ section.settings.bg | default: '#eef0f2' }};--clb-ink:{{ section.settings.ink | default: '#151a20' }};--clb-accent:{{ section.settings.accent | default: '#66788f' }};"
>
  <div class="clb__hero">
    {%- if section.settings.eyebrow != blank -%}
      <p class="clb__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="clb__title">
        <span>{{ title_parts[0] | strip | escape }}</span>
        {%- if title_parts.size > 1 -%}
          <span class="clb__out">{{ title_parts[1] | strip | escape }}</span>
        {%- endif -%}
      </h1>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="clb__sub">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    <span class="clb__side">{{ frame_total }} looks</span>
  </div>

  <div class="clb__wrap">
    {%- for block in section.blocks -%}
      {%- liquid
        assign idx = forloop.index0 | modulo: 6
        case idx
          when 0
            assign fb = 'cc-hero.jpg'
          when 1
            assign fb = 'cc-ed-top.jpg'
          when 2
            assign fb = 'cc-ed-btm.jpg'
          when 3
            assign fb = 'cc-reel-1.jpg'
          when 4
            assign fb = 'cc-reel-2.jpg'
          else
            assign fb = 'cc-reel-3.jpg'
        endcase
      -%}

      {%- comment -%} Additional portrait: sits before the fifth look {%- endcomment -%}
      {%- if forloop.index == 5 and has_extra -%}
        {%- liquid
          assign pos = fi | modulo: 8 | plus: 1
          assign num = fi | plus: 1
          assign ld = 'lazy'
          if fi == 0
            assign ld = 'eager'
          endif
        -%}
        {%- if pos == 1 -%}<div class="clb__set">{%- endif -%}

        <figure class="clb__f clb__f--{{ pos }}" data-n="{{ num | prepend: '0' | slice: -2, 2 }}">
          <div class="clb__lk">
            <div class="clb__ph">
              {%- if section.settings.extra_image != blank -%}
                {{
                  section.settings.extra_image
                  | image_url: width: 1800
                  | image_tag:
                    loading: ld,
                    widths: '400, 600, 800, 1000, 1400, 1800',
                    sizes: '(min-width: 901px) 60vw, 100vw',
                    alt: section.settings.extra_title
                }}
              {%- else -%}
                <img
                  src="{{ 'coolcolors-lookbook-ivory-charcoal-72ffd769.png' | file_url }}"
                  alt="Ivory shirt and charcoal trousers styled in a sandstone courtyard"
                  loading="lazy"
                  width="1024"
                  height="1536"
                >
              {%- endif -%}
            </div>
            <figcaption class="clb__cap">
              <span class="clb__nm">{{ section.settings.extra_title | escape }}</span>
            </figcaption>
          </div>
        </figure>

        {%- assign fi = fi | plus: 1 -%}
        {%- assign set_rem = fi | modulo: 8 -%}
        {%- if set_rem == 0 or fi == frame_total -%}</div>{%- endif -%}
      {%- endif -%}

      {%- liquid
        assign pos = fi | modulo: 8 | plus: 1
        assign num = fi | plus: 1
        assign ld = 'lazy'
        if fi == 0
          assign ld = 'eager'
        endif
      -%}
      {%- if pos == 1 -%}<div class="clb__set">{%- endif -%}

      <figure
        class="clb__f clb__f--{{ pos }}"
        data-n="{{ num | prepend: '0' | slice: -2, 2 }}"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link | escape }}" class="clb__lk">
        {%- else -%}
          <div class="clb__lk">
        {%- endif -%}

          <div class="clb__ph">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag:
                  loading: ld,
                  widths: '400, 600, 800, 1000, 1400, 1800',
                  sizes: '(min-width: 901px) 60vw, 100vw',
                  alt: block.settings.title
              }}
            {%- else -%}
              <img src="{{ fb | asset_url }}" alt="{{ block.settings.title | escape }}" loading="{{ ld }}">
            {%- endif -%}
          </div>

          <figcaption class="clb__cap">
            <span class="clb__nm">{{ block.settings.title | escape }}</span>
            {%- if block.settings.link != blank -%}
              <span class="clb__go">Explore the collection</span>
            {%- endif -%}
          </figcaption>

        {%- if block.settings.link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      </figure>

      {%- assign fi = fi | plus: 1 -%}

      {%- if fi == 2 and section.settings.quote != blank -%}
        <p class="clb__q">
          {{ quote_parts[0] | strip | escape }}
          {%- if quote_parts.size > 1 -%}<br><i>{{ quote_parts[1] | strip | escape }}</i>{%- endif -%}
        </p>
      {%- endif -%}

      {%- assign set_rem = fi | modulo: 8 -%}
      {%- if set_rem == 0 or fi == frame_total -%}</div>{%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.cta_text != blank -%}
    <div class="clb__band">
      <div class="clb__band-in">
        <div class="clb__band-txt">
          {%- if section.settings.band_label != blank -%}
            <p class="clb__band-label">{{ section.settings.band_label | escape }}</p>
          {%- endif -%}
          <h2>
            {{ band_parts[0] | strip | escape }}
            {%- if band_parts.size > 1 -%}<span>{{ band_parts[1] | strip | escape }}</span>{%- endif -%}
          </h2>
        </div>
        {%- if section.settings.cta_link != blank and section.settings.cta_btn != blank -%}
          <a href="{{ section.settings.cta_link | escape }}" class="clb__btn">{{ section.settings.cta_btn | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  .clb{ --clb-mut:#5f6a74; --clb-line:#cdd3d8; --clb-tint:#e1e6ea; }
  @supports (color: color-mix(in srgb, red, blue)){
    .clb{
      --clb-mut: color-mix(in srgb, var(--clb-ink) 60%, var(--clb-bg));
      --clb-line: color-mix(in srgb, var(--clb-ink) 16%, var(--clb-bg));
      --clb-tint: color-mix(in srgb, var(--clb-accent) 14%, var(--clb-bg));
    }
  }

  .clb, .clb *, .clb *::before, .clb *::after{ box-sizing:border-box; }
  .clb{ position:relative; display:block; background:var(--clb-bg); color:var(--clb-ink); font-family:inherit; overflow-x:clip; -webkit-font-smoothing:antialiased; }
  .clb--font{ font-family:'Bricolage Grotesque','Helvetica Neue',Arial,sans-serif; }
  .clb h1, .clb h2, .clb h3, .clb p, .clb span, .clb a, .clb i, .clb figcaption{ font-family:inherit !important; }
  .clb a{ color:inherit; }

  /* ---------- Hero ---------- */
  .clb .clb__hero{ position:relative; display:block; max-width:1500px; margin:0 auto; padding:9vw 5vw 5vw; background:none; border:0; }
  .clb .clb__eyebrow{ margin:0 0 3vw; max-width:300px; font-size:14px; line-height:1.5; font-weight:400; letter-spacing:0; text-transform:none; color:var(--clb-mut) !important; }
  .clb .clb__title{ margin:0; padding:0; font-size:clamp(52px,11.5vw,190px); font-weight:600; font-stretch:75%; line-height:.86; letter-spacing:-.055em; text-transform:uppercase; color:var(--clb-ink) !important; }
  .clb .clb__title span{ display:block; white-space:nowrap; }
  .clb .clb__title .clb__out{ margin-left:9vw; font-weight:300; color:var(--clb-accent) !important; }
  .clb .clb__sub{ position:absolute; right:5vw; top:12vw; max-width:280px; margin:0; font-size:clamp(14px,1.15vw,16px); line-height:1.7; font-weight:400; color:var(--clb-mut) !important; }
  .clb .clb__side{ position:absolute; left:1.4vw; bottom:5vw; writing-mode:vertical-rl; transform:rotate(180deg); font-size:12px; letter-spacing:.14em; color:var(--clb-mut); }

  /* ---------- Grid ---------- */
  .clb .clb__wrap{ max-width:1500px; margin:0 auto; padding:5vw 5vw 8vw; }
  .clb .clb__set{ display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:2vw; }

  .clb .clb__f{ position:relative; min-width:0; margin:0 0 6vw; padding:0; background:none; border:0; border-radius:0; }
  .clb .clb__f::before{
    content:attr(data-n); position:absolute; z-index:4; top:-.4em;
    font-size:clamp(64px,9vw,140px); font-weight:200; font-stretch:75%; line-height:1; letter-spacing:-.06em;
    color:transparent; -webkit-text-stroke:1px var(--clb-accent); pointer-events:none;
  }
  .clb .clb__f--1::before, .clb .clb__f--3::before, .clb .clb__f--6::before, .clb .clb__f--8::before{ left:-.1em; }
  .clb .clb__f--2::before, .clb .clb__f--4::before, .clb .clb__f--5::before, .clb .clb__f--7::before{ right:-.1em; }

  .clb .clb__lk{ position:relative; display:block; color:var(--clb-ink); text-decoration:none; }
  .clb .clb__ph{ position:relative; overflow:hidden; aspect-ratio:var(--clb-ar,3/4); background:var(--clb-line); border-radius:0; }
  .clb .clb__ph img{ position:absolute; inset:0; display:block; width:100%; height:100%; max-width:none; object-fit:cover; border-radius:0; transition:transform 1.4s cubic-bezier(.2,.8,.2,1); }

  .clb .clb__cap{ display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:4px 12px; padding:14px 0 0; background:none; }
  .clb .clb__nm{ font-size:clamp(16px,1.4vw,21px); font-weight:500; line-height:1.25; letter-spacing:-.02em; color:var(--clb-ink); }
  .clb .clb__go{ font-size:12px; line-height:1.5; color:var(--clb-mut); border-bottom:1px solid var(--clb-line); padding-bottom:2px; white-space:nowrap; transition:color .2s, border-color .2s; }

  .clb .clb__q{ grid-column:1/13; grid-row:2; margin:8vw 0 6vw; padding-left:18%; font-size:clamp(30px,5.4vw,88px); font-weight:500; font-stretch:80%; line-height:1; letter-spacing:-.045em; color:var(--clb-ink) !important; }
  .clb .clb__q i{ font-style:normal; font-weight:300; color:var(--clb-accent); }

  .clb .clb__f--1{ grid-column:1/8;  grid-row:1; --clb-ar:4/5; }
  .clb .clb__f--2{ grid-column:9/13; grid-row:1; --clb-ar:1/1; margin-top:20vw; }
  .clb .clb__f--3{ grid-column:2/7;  grid-row:3; --clb-ar:2/3; margin-top:6vw; z-index:1; }
  .clb .clb__f--4{ grid-column:6/13; grid-row:3; --clb-ar:3/2; margin-top:15vw; z-index:2; }
  .clb .clb__f--5{ grid-column:1/6;  grid-row:4; --clb-ar:3/4; margin-top:4vw; }
  .clb .clb__f--6{ grid-column:8/13; grid-row:4; --clb-ar:2/3; margin-top:-3vw; }
  .clb .clb__f--7{ grid-column:3/13; grid-row:5; --clb-ar:16/9; margin-top:3vw; }
  .clb .clb__f--8{ grid-column:1/5;  grid-row:5; --clb-ar:3/4; margin-top:20vw; z-index:3; }
  .clb .clb__f--8 .clb__ph{ box-shadow:0 0 0 10px var(--clb-bg); }

  .clb .clb__f--7 .clb__ph::after{ content:""; position:absolute; left:0; right:0; bottom:0; height:45%; z-index:2; background:linear-gradient(transparent, rgba(12,16,22,.55)); pointer-events:none; }
  .clb .clb__f--7 .clb__cap{ position:absolute; right:0; bottom:0; z-index:3; flex-direction:column; align-items:flex-end; gap:6px; padding:0 clamp(16px,2.2vw,32px) clamp(16px,2.2vw,30px); text-align:right; }
  .clb .clb__f--7 .clb__nm{ color:#fff; }
  .clb .clb__f--7 .clb__go{ color:rgba(255,255,255,.88); border-color:rgba(255,255,255,.4); }

  /* ---------- Closing: soft tint, dark text ---------- */
  .clb .clb__band{ background:var(--clb-tint); color:var(--clb-ink); padding:7vw 5vw; border-top:1px solid var(--clb-line); }
  .clb .clb__band-in{ display:flex; align-items:flex-end; justify-content:space-between; flex-wrap:wrap; gap:32px; max-width:1500px; margin:0 auto; }
  .clb .clb__band-label{ margin:0 0 20px; font-size:14px; letter-spacing:0; text-transform:none; color:var(--clb-mut) !important; }
  .clb .clb__band h2{ margin:0; font-size:clamp(40px,7vw,110px); font-weight:600; font-stretch:75%; line-height:.9; letter-spacing:-.05em; text-transform:uppercase; color:var(--clb-ink) !important; }
  .clb .clb__band h2 span{ display:block; font-weight:300; color:var(--clb-accent) !important; }
  .clb .clb__btn{ display:inline-flex; align-items:center; justify-content:center; min-height:52px; padding:16px 34px; background:var(--clb-ink); color:var(--clb-bg) !important; font-size:14px; font-weight:500; letter-spacing:.01em; text-decoration:none; border:1px solid var(--clb-ink); border-radius:0; transition:background .2s, color .2s; }

  .clb a.clb__lk:focus-visible, .clb .clb__btn:focus-visible{ outline:2px solid var(--clb-accent); outline-offset:5px; }

  .clb--themefont .clb__title{ font-size:clamp(44px,8vw,140px); font-stretch:100%; letter-spacing:-.04em; }
  .clb--themefont .clb__band h2{ font-size:clamp(36px,6vw,96px); font-stretch:100%; letter-spacing:-.04em; }
  .clb--themefont .clb__q{ font-size:clamp(28px,4.4vw,72px); font-stretch:100%; }
  .clb--themefont .clb__f::before{ font-stretch:100%; }

  /* image reveal */
  .clb--js .clb__ph{ clip-path:inset(0 0 100% 0); transition:clip-path 1.1s cubic-bezier(.2,.8,.2,1); }
  .clb--js .clb__f.in .clb__ph{ clip-path:inset(0); }
  .clb--js .clb__ph img{ transform:scale(1.06); }
  .clb--js .clb__f.in .clb__ph img{ transform:scale(1); }

  @media (hover:hover){
    .clb .clb__f a.clb__lk:hover .clb__ph img{ transform:scale(1.03); }
    .clb .clb__f a.clb__lk:hover .clb__go{ color:var(--clb-ink); border-color:var(--clb-ink); }
    .clb .clb__f--7 a.clb__lk:hover .clb__go{ color:#fff; border-color:#fff; }
    .clb .clb__btn:hover{ background:transparent; color:var(--clb-ink) !important; }
  }
  @media (prefers-reduced-motion:reduce){
    .clb--js .clb__ph{ clip-path:none; transition:none; }
    .clb--js .clb__ph img, .clb--js .clb__f.in .clb__ph img{ transform:none; transition:none; }
    .clb .clb__f a.clb__lk:hover .clb__ph img{ transform:none; }
  }

  @media (max-width:900px){
    .clb .clb__sub{ position:static; margin:5vw 0 0 auto; max-width:300px; }
    .clb .clb__f--2{ margin-top:14vw; }
    .clb .clb__f--4{ margin-top:10vw; }
    .clb .clb__f--8{ margin-top:12vw; }
    .clb .clb__f--8 .clb__ph{ box-shadow:0 0 0 8px var(--clb-bg); }
  }

  @media (max-width:620px){
    .clb .clb__hero{ padding:14vw 20px 8vw; }
    .clb .clb__eyebrow{ margin-bottom:7vw; }
    .clb .clb__title{ font-size:14.5vw; }
    .clb .clb__title .clb__out{ margin-left:7vw; }
    .clb .clb__sub{ margin:6vw 0 0 14%; max-width:none; font-size:14px; }
    .clb .clb__side{ display:none; }

    .clb .clb__wrap{ padding:10vw 20px 14vw; }
    .clb .clb__set{ display:flex; flex-direction:column; }
    .clb .clb__set .clb__f{ margin:0 0 15vw; }
    .clb .clb__f::before{ font-size:72px; top:-.36em; }
    .clb .clb__f--1::before, .clb .clb__f--3::before, .clb .clb__f--6::before, .clb .clb__f--8::before{ left:-4px; right:auto; }
    .clb .clb__f--2::before, .clb .clb__f--5::before{ right:-4px; left:auto; }
    .clb .clb__f--4::before, .clb .clb__f--7::before{ right:22px; left:auto; }

    .clb .clb__cap{ flex-direction:column; align-items:flex-start; gap:6px; padding-top:12px; }
    .clb .clb__nm{ font-size:17px; }

    .clb .clb__set .clb__f--1{ width:100%; }
    .clb .clb__set .clb__f--2{ width:66%; align-self:flex-end; }
    .clb .clb__q{ margin:0 0 15vw; padding:0; font-size:11.5vw; }
    .clb .clb__set .clb__f--3{ width:80%; align-self:flex-start; }
    .clb .clb__set .clb__f--4{ width:calc(100% + 20px); margin-right:-20px; align-self:flex-end; }
    .clb .clb__set .clb__f--5{ width:72%; align-self:flex-end; }
    .clb .clb__set .clb__f--6{ width:90%; align-self:flex-start; }
    .clb .clb__set .clb__f--7{ width:calc(100% + 40px); margin:0 -20px; align-self:center; }
    .clb .clb__set .clb__f--8{ width:58%; align-self:flex-start; margin-top:-18vw; }
    .clb .clb__f--8 .clb__ph{ box-shadow:0 0 0 6px var(--clb-bg); }
    .clb .clb__f--7 .clb__cap{ padding:0 20px 18px; }
    .clb .clb__f--7 .clb__nm{ font-size:16px; }

    .clb .clb__band{ padding:14vw 20px; }
    .clb .clb__band-in{ display:block; }
    .clb .clb__band h2{ font-size:14vw; margin-bottom:9vw; }
    .clb .clb__btn{ display:flex; width:100%; }

    .clb--themefont .clb__title{ font-size:11vw; }
    .clb--themefont .clb__band h2{ font-size:11vw; }
    .clb--themefont .clb__q{ font-size:9vw; }
  }
</style>

<script>
(function(){
  var root = document.getElementById('clb-{{ section.id }}');
  if(!root) return;
  var frames = root.querySelectorAll('.clb__f');
  function showAll(){ Array.prototype.forEach.call(frames, function(f){ f.classList.add('in'); }); }
  if(!('IntersectionObserver' in window) || (window.Shopify && Shopify.designMode)){ showAll(); return; }
  root.classList.add('clb--js');
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, { threshold:.12, rootMargin:'0px 0px -6% 0px' });
  Array.prototype.forEach.call(frames, function(f){ io.observe(f); });
})();
</script>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Small intro line", "default": "Lookbook: the everyday edit" },
    { "type": "text", "id": "title", "label": "Title (use / to split into two lines)", "info": "Keep each line short, e.g. The Edit/Season One.", "default": "The Edit/Season One" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Clean lines. Considered textures. Everyday menswear, styled with quiet confidence." },
    { "type": "text", "id": "quote", "label": "Pull-quote after the second look (use / for the accent line)", "info": "Leave blank to hide.", "default": "Cut quiet./Worn loud." },
    { "type": "header", "content": "Additional portrait" },
    { "type": "paragraph", "content": "Appears before the fifth look. If no image is selected, the generated Ivory & Charcoal image is used. Needs at least 5 looks to show." },
    { "type": "image_picker", "id": "extra_image", "label": "Additional portrait image" },
    { "type": "text", "id": "extra_title", "label": "Additional portrait title", "default": "Ivory & Charcoal" },
    { "type": "header", "content": "Closing banner" },
    { "type": "text", "id": "band_label", "label": "Small label", "default": "The Coolcolors edit" },
    { "type": "text", "id": "cta_text", "label": "Banner text (use / for a second line)", "default": "Wear/the story." },
    { "type": "text", "id": "cta_btn", "label": "Banner button", "default": "Shop new arrivals" },
    { "type": "url", "id": "cta_link", "label": "Banner link" },
    { "type": "header", "content": "Design" },
    { "type": "checkbox", "id": "display_font", "label": "Use the Bricolage Grotesque display font", "info": "Recommended. Turn off to use your theme font.", "default": true },
    { "type": "color", "id": "accent", "label": "Accent colour", "default": "#66788f" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#eef0f2" },
    { "type": "color", "id": "ink", "label": "Text colour", "default": "#151a20" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
