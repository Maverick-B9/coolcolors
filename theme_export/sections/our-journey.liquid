{% comment %}
  Section: Our Journey
  Figma: "About & Our Journey" → Desktop + Mobile
  - Eyebrow "OUR JOURNEY"
  - Heading: "Built on fit, fabric, and a quiet commitment to every detail."
  - Paragraph from Figma
  - "Explore the timeline" CTA (primary) + "Read the story" CTA (secondary)
  - Editorial image with "Editorial story" tag
  - Milestones block: 4 cards (2012, 2016, 2020, 2024) with exact Figma titles/descriptions
{% endcomment %}

<section
  class="our-journey section-{{ section.id }}"
  id="our-journey-{{ section.id }}"
>
  {%- comment -%} Intro block {%- endcomment -%}
  <div class="our-journey__intro row">
    <div class="our-journey__intro-content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="our-journey__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="our-journey__heading">{{ section.settings.heading }}</h1>
      {%- if section.settings.paragraph != blank -%}
        <div class="our-journey__para rte">{{ section.settings.paragraph }}</div>
      {%- endif -%}
      <div class="our-journey__ctas">
        {%- if section.settings.cta1_text != blank -%}
          <a href="{{ section.settings.cta1_url | default: '#milestones' }}" class="our-journey__cta our-journey__cta--primary">
            {{ section.settings.cta1_text }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_text != blank -%}
          <a href="{{ section.settings.cta2_url | default: '/collections/all' }}" class="our-journey__cta our-journey__cta--secondary">
            {{ section.settings.cta2_text }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="our-journey__intro-image">
      {%- if section.settings.editorial_image != blank -%}
        <div class="our-journey__image-wrap">
          {{ section.settings.editorial_image | image_url: width: 800 | image_tag:
            loading: 'eager',
            class: 'our-journey__image',
            alt: section.settings.editorial_image.alt | default: 'Cool Colors editorial'
          }}
          {%- if section.settings.image_tag != blank -%}
            <span class="our-journey__image-tag">{{ section.settings.image_tag }}</span>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="our-journey__image-wrap our-journey__image-wrap--placeholder">
          <div class="our-journey__image-placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
          {%- if section.settings.image_tag != blank -%}
            <span class="our-journey__image-tag">{{ section.settings.image_tag }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Milestones {%- endcomment -%}
  {%- assign milestone_blocks = section.blocks | where: 'type', 'milestone' -%}
  {%- if milestone_blocks.size > 0 -%}
    <div class="our-journey__milestones" id="milestones">
      <div class="row">
        <div class="our-journey__milestones-header">
          <h2 class="our-journey__milestones-title">{{ section.settings.milestones_heading | default: 'Milestones' }}</h2>
          {%- if section.settings.milestones_subheading != blank -%}
            <p class="our-journey__milestones-sub">{{ section.settings.milestones_subheading }}</p>
          {%- endif -%}
        </div>

        <div class="our-journey__milestones-range">{{ section.settings.milestones_range | default: '2012 - 2024' }}</div>

        <div class="our-journey__milestones-grid">
          {%- for block in milestone_blocks -%}
            <div class="our-journey__milestone-card" {{ block.shopify_attributes }}>
              <div class="our-journey__milestone-number">{{ block.settings.number | default: '01' }}</div>
              <div class="our-journey__milestone-year">{{ block.settings.year }}</div>
              <h3 class="our-journey__milestone-title">{{ block.settings.title }}</h3>
              <p class="our-journey__milestone-desc">{{ block.settings.description }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  #our-journey-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
  }

  /* Intro */
  #our-journey-{{ section.id }} .our-journey__intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
    padding-top: 96px;
    padding-bottom: 80px;
  }

  #our-journey-{{ section.id }} .our-journey__eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #D92231;
    margin: 0 0 16px;
  }

  #our-journey-{{ section.id }} .our-journey__heading {
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 700;
    color: #0D1117;
    margin: 0 0 24px;
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  #our-journey-{{ section.id }} .our-journey__para {
    font-size: 18px;
    color: #5C6874;
    line-height: 1.65;
    margin: 0 0 36px;
  }

  #our-journey-{{ section.id }} .our-journey__ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  #our-journey-{{ section.id }} .our-journey__cta {
    display: inline-block;
    padding: 14px 28px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 2px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  #our-journey-{{ section.id }} .our-journey__cta--primary {
    background-color: #0D1117;
    color: #FFFFFF;
    border: 2px solid #0D1117;
  }

  #our-journey-{{ section.id }} .our-journey__cta--primary:hover {
    background-color: #161D26;
    border-color: #161D26;
  }

  #our-journey-{{ section.id }} .our-journey__cta--secondary {
    background-color: transparent;
    color: #D92231;
    border: 2px solid transparent;
  }

  #our-journey-{{ section.id }} .our-journey__cta--secondary:hover {
    border-color: #D92231;
  }

  /* Editorial image */
  #our-journey-{{ section.id }} .our-journey__image-wrap {
    position: relative;
    border-radius: 2px;
    overflow: hidden;
  }

  #our-journey-{{ section.id }} .our-journey__image {
    width: 100%;
    height: auto;
    display: block;
  }

  #our-journey-{{ section.id }} .our-journey__image-wrap--placeholder {
    background: #EDEFF2;
    aspect-ratio: 4/5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #our-journey-{{ section.id }} .our-journey__image-placeholder {
    width: 100%;
    height: 100%;
  }

  #our-journey-{{ section.id }} .our-journey__image-tag {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background: rgba(13,17,23,0.85);
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 2px;
    backdrop-filter: blur(4px);
  }

  /* Milestones */
  #our-journey-{{ section.id }} .our-journey__milestones {
    background-color: {{ section.settings.milestones_bg | default: '#EDEFF2' }};
    padding: 80px 0;
  }

  #our-journey-{{ section.id }} .our-journey__milestones-header {
    margin-bottom: 8px;
  }

  #our-journey-{{ section.id }} .our-journey__milestones-title {
    font-size: 32px;
    font-weight: 700;
    color: #0D1117;
    margin: 0 0 8px;
  }

  #our-journey-{{ section.id }} .our-journey__milestones-sub {
    font-size: 16px;
    color: #5C6874;
    margin: 0 0 24px;
  }

  #our-journey-{{ section.id }} .our-journey__milestones-range {
    font-size: 13px;
    font-weight: 600;
    color: #0D1117;
    margin-bottom: 40px;
    padding-bottom: 16px;
    border-bottom: 2px solid #CCD3DA;
  }

  #our-journey-{{ section.id }} .our-journey__milestones-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  #our-journey-{{ section.id }} .our-journey__milestone-card {
    padding: 24px;
    background: #FFFFFF;
    border-radius: 2px;
    border: 1px solid #DDE2E7;
  }

  #our-journey-{{ section.id }} .our-journey__milestone-number {
    font-size: 16px;
    font-weight: 700;
    color: #D92231;
    margin-bottom: 8px;
    line-height: 1;
  }

  #our-journey-{{ section.id }} .our-journey__milestone-year {
    font-size: 14px;
    font-weight: 700;
    color: #0D1117;
    margin-bottom: 8px;
  }

  #our-journey-{{ section.id }} .our-journey__milestone-title {
    font-size: 22px;
    font-weight: 700;
    color: #0D1117;
    margin: 0 0 12px;
    line-height: 1.2;
  }

  #our-journey-{{ section.id }} .our-journey__milestone-desc {
    font-size: 15px;
    color: #5C6874;
    margin: 0;
    line-height: 1.6;
  }

  /* Mobile */
  @media screen and (max-width: 768px) {
    #our-journey-{{ section.id }} .our-journey__intro {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 56px;
      padding-bottom: 56px;
    }

    #our-journey-{{ section.id }} .our-journey__heading {
      font-size: clamp(24px, 6vw, 32px);
    }

    #our-journey-{{ section.id }} .our-journey__para {
      font-size: 14px;
    }

    #our-journey-{{ section.id }} .our-journey__milestones-grid {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    #our-journey-{{ section.id }} .our-journey__milestones-title {
      font-size: 24px;
    }
  }

  @media screen and (max-width: 480px) {
    #our-journey-{{ section.id }} .our-journey__milestones-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Our Journey",
  "class": "our-journey-section",
  "settings": [
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR JOURNEY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built on fit, fabric, and a quiet commitment to every detail."
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "<p>Cool Colors began as a premium menswear house and grew into a trusted Indian fashion brand with a presence across the country. Today, the story is still rooted in the same discipline: sharp tailoring, thoughtful fabric selection, and a team that treats every garment like a promise kept.</p>"
    },
    {
      "type": "text",
      "id": "cta1_text",
      "label": "CTA 1 text",
      "default": "Explore the timeline"
    },
    {
      "type": "url",
      "id": "cta1_url",
      "label": "CTA 1 URL"
    },
    {
      "type": "text",
      "id": "cta2_text",
      "label": "CTA 2 text",
      "default": "Read the story"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "CTA 2 URL"
    },
    {
      "type": "image_picker",
      "id": "editorial_image",
      "label": "Editorial image"
    },
    {
      "type": "text",
      "id": "image_tag",
      "label": "Image tag label",
      "default": "Editorial story"
    },
    {
      "type": "header",
      "content": "Milestones"
    },
    {
      "type": "text",
      "id": "milestones_heading",
      "label": "Milestones heading",
      "default": "Milestones"
    },
    {
      "type": "text",
      "id": "milestones_subheading",
      "label": "Milestones subheading",
      "default": "A few moments that shaped the brand."
    },
    {
      "type": "text",
      "id": "milestones_range",
      "label": "Year range label",
      "default": "2012 - 2024"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "milestones_bg",
      "label": "Milestones background",
      "default": "#EDEFF2"
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number label",
          "default": "01",
          "info": "Displayed in signal red above the year"
        },
        {
          "type": "text",
          "id": "year",
          "label": "Year",
          "default": "2012"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Founded in Jodhpur"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Cool Colors started as a premium menswear house with a sharp focus on tailoring and fabric selection."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Journey",
      "category": "Brand",
      "blocks": [
        {
          "type": "milestone",
          "settings": {
            "number": "01",
            "year": "2012",
            "title": "Founded in Jodhpur",
            "description": "Cool Colors started as a premium menswear house with a sharp focus on tailoring and fabric selection."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "number": "02",
            "year": "2016",
            "title": "First retail flagship",
            "description": "The brand opened its first flagship store, bringing a refined menswear experience to the market."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "number": "03",
            "year": "2020",
            "title": "National retail expansion",
            "description": "Cool Colors expanded into new cities, bringing its signature tailoring and fabric-led collections to more customers."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "number": "04",
            "year": "2024",
            "title": "Expanded fabric sourcing",
            "description": "New partnerships were added to support growing demand while preserving the same standards of quality and craftsmanship."
          }
        }
      ]
    }
  ]
}
{% endschema %}
