{%- liquid
  assign autoplay = section.settings.autoplay
-%}
<section class="ccs" id="ccs-{{ section.id }}" data-ccs data-autoplay="{{ autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}" aria-roledescription="carousel">
  <div class="ccs__track">
    {%- for block in section.blocks -%}
      {%- liquid
        case forloop.index
          when 2
            assign fb = 'cc-ed-top.jpg'
          when 3
            assign fb = 'cc-ed-btm.jpg'
          else
            assign fb = 'cc-hero.jpg'
        endcase
      -%}
      <div class="ccs__slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }} aria-hidden="{% unless forloop.first %}true{% else %}false{% endunless %}">
        <picture>
          {%- if block.settings.mobile_image != blank -%}
            <source media="(max-width:768px)" srcset="{{ block.settings.mobile_image | image_url: width: 900 }}">
          {%- endif -%}
          {%- if block.settings.image != blank -%}
            <img class="ccs__img" src="{{ block.settings.image | image_url: width: 2000 }}" alt="{{ block.settings.image.alt | default: shop.name | escape }}" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
          {%- else -%}
            <img class="ccs__img" src="{{ fb | asset_url }}" alt="{{ shop.name | escape }}" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
          {%- endif -%}
        </picture>
        <div class="ccs__shade"></div>
        {%- assign banner_link = block.settings.link | default: block.settings.primary_link -%}
        {%- if banner_link != blank -%}
          <a href="{{ banner_link }}" class="ccs__link" aria-label="{{ block.settings.heading | default: block.settings.primary_btn | default: shop.name | escape }}" tabindex="-1"></a>
        {%- endif -%}
        <div class="ccs__content">
          {%- if block.settings.heading != blank -%}<h1 class="ccs__heading">{{ block.settings.heading }}</h1>{%- endif -%}
          <div class="ccs__btns">
            {%- if block.settings.primary_btn != blank -%}
              <a href="{{ block.settings.primary_link | default: '/collections/new-arrival' }}" class="ccs__btn ccs__btn--primary">{{ block.settings.primary_btn }}</a>
            {%- endif -%}
            {%- if block.settings.secondary_btn != blank -%}
              <a href="{{ block.settings.secondary_link | default: '/pages/our-story' }}" class="ccs__btn ccs__btn--secondary">{{ block.settings.secondary_btn }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    {%- if section.settings.show_arrows -%}
      <button type="button" class="ccs__arrow ccs__arrow--prev" data-prev aria-label="Previous slide"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
      <button type="button" class="ccs__arrow ccs__arrow--next" data-next aria-label="Next slide"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
    {%- endif -%}
    {%- if section.settings.show_dots -%}
      <div class="ccs__dots" role="tablist">
        {%- for block in section.blocks -%}<button type="button" class="ccs__dot{% if forloop.first %} is-active{% endif %}" data-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>{%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

<style>
  .ccs { position:relative; width:100%; min-height:max(100vh,760px); overflow:hidden; background:#E6EAEF; font-family:'Inter',system-ui,sans-serif; }
  .ccs, .ccs * { box-sizing:border-box; font-family:'Inter',system-ui,sans-serif; }
  .ccs__track { position:absolute; inset:0; }
  .ccs__slide { position:absolute; inset:0; opacity:0; visibility:hidden; transition:opacity .8s ease, visibility .8s; }
  .ccs__slide.is-active { opacity:1; visibility:visible; z-index:2; }
  .ccs__img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center top; display:block; transform:scale(1.04); transition:transform 6s ease-out; }
  .ccs__slide.is-active .ccs__img { transform:scale(1); }
  .ccs__link { position:absolute; inset:0; z-index:2; display:block; }
  .ccs__shade { position:absolute; inset:0; background:linear-gradient(180deg,rgba(13,17,23,0) 55%,rgba(13,17,23,.38) 100%); pointer-events:none; }
  .ccs__content { position:absolute; left:0; right:0; bottom:0; padding:0 8% 76px; z-index:3; pointer-events:none; display:flex; flex-direction:column; align-items:flex-start; gap:22px; }
  .ccs__heading { margin:0; max-width:640px; font-size:56px; line-height:1.05; font-weight:800; letter-spacing:-1.5px; color:#fff; text-shadow:0 2px 18px rgba(0,0,0,.25); }
  .ccs__btns { display:flex; gap:14px; flex-wrap:wrap; opacity:0; transform:translateY(16px); transition:opacity .6s ease .35s, transform .6s ease .35s; }
  .ccs__slide.is-active .ccs__btns, .ccs__slide.is-active .ccs__heading { opacity:1; transform:none; }
  .ccs__btn { pointer-events:auto; display:inline-flex; align-items:center; justify-content:center; padding:16px 34px; border-radius:100px; font-size:14px; font-weight:600; text-decoration:none; line-height:1.2; white-space:nowrap; transition:opacity .2s, transform .15s; }
  .ccs__btn:hover { opacity:.9; } .ccs__btn:active { transform:scale(.97); }
  .ccs__btn--primary { background:#D92231; color:#fff; }
  .ccs__btn--secondary { background:#fff; color:#0D1117; box-shadow:0 4px 12px rgba(0,0,0,.08); }
  .ccs__arrow { position:absolute; top:50%; transform:translateY(-50%); z-index:5; width:48px; height:48px; border-radius:50%; border:0; background:rgba(255,255,255,.9); color:#0D1117; display:grid; place-items:center; cursor:pointer; box-shadow:0 6px 18px rgba(0,0,0,.18); transition:background .2s, transform .15s; }
  .ccs__arrow:hover { background:#fff; transform:translateY(-50%) scale(1.06); }
  .ccs__arrow--prev { left:24px; } .ccs__arrow--next { right:24px; }
  .ccs__dots { position:absolute; left:50%; bottom:26px; transform:translateX(-50%); z-index:5; display:flex; gap:8px; }
  .ccs__dot { width:8px; height:8px; padding:0; border:0; border-radius:100px; background:rgba(255,255,255,.55); cursor:pointer; transition:width .3s, background .3s; }
  .ccs__dot.is-active { width:28px; background:#fff; }
  @media (max-width:768px){
    .ccs { min-height:560px; height:calc(100svh - 40px); max-height:780px; aspect-ratio:auto; }
    .ccs__img { object-position:60% 15%; }
    .ccs__content { padding:0 16px 104px; gap:14px; align-items:stretch; }
    .ccs__heading { font-size:26px; letter-spacing:-.6px; }
    .ccs__btns { flex-wrap:nowrap; gap:10px; }
    .ccs__btn { flex:1 1 0; min-width:0; min-height:50px; padding:14px 8px; font-size:14px; }
    .ccs__arrow { display:none; }
    .ccs__dots { bottom:82px; }
  }
  @media (max-width:360px){ .ccs__btn { font-size:12px; padding:12px 6px; } }
</style>

<script>
(function(){
  function init(root){
    if(!root || root.__ccs) return; root.__ccs = true;
    var slides = root.querySelectorAll('[data-slide]'), dots = root.querySelectorAll('[data-dot]'), n = slides.length, i = 0, timer;
    if(n < 2) return;
    function go(k){
      i = (k + n) % n;
      slides.forEach(function(s,x){ s.classList.toggle('is-active', x===i); s.setAttribute('aria-hidden', x===i ? 'false':'true'); });
      dots.forEach(function(d,x){ d.classList.toggle('is-active', x===i); });
    }
    function play(){ stop(); if(root.dataset.autoplay === 'true'){ timer = setInterval(function(){ go(i+1); }, +root.dataset.interval || 5000); } }
    function stop(){ clearInterval(timer); }
    var p = root.querySelector('[data-prev]'), nx = root.querySelector('[data-next]');
    if(p) p.addEventListener('click', function(){ go(i-1); play(); });
    if(nx) nx.addEventListener('click', function(){ go(i+1); play(); });
    dots.forEach(function(d){ d.addEventListener('click', function(){ go(+d.dataset.dot); play(); }); });
    var sx = null;
    root.addEventListener('touchstart', function(e){ sx = e.touches[0].clientX; }, {passive:true});
    root.addEventListener('touchend', function(e){ if(sx===null) return; var dx = e.changedTouches[0].clientX - sx; if(Math.abs(dx) > 40){ go(dx < 0 ? i+1 : i-1); play(); } sx = null; }, {passive:true});
    document.addEventListener('visibilitychange', function(){ document.hidden ? stop() : play(); });
    root.addEventListener('shopify:block:select', function(e){ var k = Array.prototype.indexOf.call(slides, e.target); if(k > -1){ stop(); go(k); } });
    root.addEventListener('shopify:section:deselect', play);
    play();
  }
  function boot(){ document.querySelectorAll('[data-ccs]').forEach(init); }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  document.addEventListener('shopify:section:load', boot);
})();
</script>

{% schema %}
{
  "name": "Hero slideshow",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "interval", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Seconds per slide", "default": 5 },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows (desktop)", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Show dots", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Banner image (desktop)" },
        { "type": "image_picker", "id": "mobile_image", "label": "Banner image (mobile, optional)" },
        { "type": "url", "id": "link", "label": "Banner link (tap anywhere on the banner)", "info": "Pick a collection or product. If empty, the banner uses the primary button link." },
        { "type": "text", "id": "heading", "label": "Heading (optional, leave empty for buttons only)" },
        { "type": "text", "id": "primary_btn", "label": "Primary button text", "default": "Shop the collection" },
        { "type": "url", "id": "primary_link", "label": "Primary button link" },
        { "type": "text", "id": "secondary_btn", "label": "Secondary button text", "default": "View editorial" },
        { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Hero slideshow", "blocks": [ { "type": "slide" }, { "type": "slide" } ] }
  ]
}
{% endschema %}