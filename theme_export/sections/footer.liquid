<footer class="cc-footer">
  <div class="cc-wrap">
    <div class="cc-footer__top">
      <div class="cc-footer__brand">
        <div class="cc-footer__logo">
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name | escape }}" style="max-width:{{ section.settings.logo_width }}px;height:auto">
          {%- else -%}
            <span class="cc-footer__mark">CC</span>
            <span><strong>{{ shop.name | upcase }}</strong><small>{{ section.settings.tagline }}</small></span>
          {%- endif -%}
        </div>
        {%- if section.settings.description != blank -%}<p>{{ section.settings.description }}</p>{%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' and block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 -%}
          <div class="cc-footer__col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.title }}</h4>
            <ul>{%- for link in linklists[block.settings.menu].links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="cc-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright }}</span>
      <span class="cc-footer__legal">
        {%- if policies.privacy_policy -%}<a href="{{ policies.privacy_policy.url }}">Privacy</a>{%- endif -%}
        {%- if policies.terms_of_service -%}<a href="{{ policies.terms_of_service.url }}">Terms</a>{%- endif -%}
      </span>
    </div>
  </div>

  {%- assign wa = section.settings.whatsapp | replace: '+', '' | replace: ' ', '' | replace: '-', '' -%}
  {%- if section.settings.show_whatsapp and wa != blank -%}
    <a class="cc-wa" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.700-5.400A8.400 8.400 0 1 1 21 11.500z"/><path d="M9 9.500c.5 2 2.500 4 5 5l1.500-1.500-2-1-1 .8c-.8-.4-1.600-1.200-2-2l.8-1-1-2z" fill="#fff" stroke="none"/></svg>
    </a>
  {%- endif -%}
</footer>

<style>
  .cc-footer { font-family:'Inter',system-ui,sans-serif !important; background:#0B0F14 !important; color:#fff !important; border-top:0; padding:64px 0 28px; margin:0; }
  .cc-footer, .cc-footer * { font-family:'Inter',system-ui,sans-serif; box-sizing:border-box; }
  .cc-footer .cc-wrap { max-width:1440px; margin:0 auto; padding:0 48px; width:100%; }
  .cc-footer__top { display:grid; grid-template-columns:1.4fr repeat(4,minmax(0,1fr)); gap:40px; }
  .cc-footer__logo { display:flex; align-items:center; gap:12px; margin-bottom:18px; }
  .cc-footer__logo > span:last-child { display:flex; flex-direction:column; line-height:1.25; }
  .cc-footer__logo strong { font-size:16px; font-weight:700; letter-spacing:.2px; color:#fff !important; }
  .cc-footer__logo small { font-size:13px; color:#8A94A0 !important; }
  .cc-footer__mark { width:50px; height:50px; border-radius:14px; background:#D92231; color:#fff !important; font-weight:800; font-size:16px; display:grid; place-items:center; }
  .cc-footer__brand p { color:#7C8794 !important; font-size:16px; line-height:1.7; max-width:340px; margin:0; }
  .cc-footer__col h4 { font-size:13px; font-weight:700; margin:6px 0 22px; color:#fff !important; text-transform:uppercase; letter-spacing:.08em; }
  .cc-footer__col ul { list-style:none; margin:0; padding:0; display:grid; gap:16px; }
  .cc-footer__col li { margin:0; padding:0; line-height:1.4; }
  .cc-footer__col a { color:#fff !important; text-decoration:none; font-size:16px; transition:color .2s, opacity .2s; }
  .cc-footer__col a:hover { color:#D92231 !important; }
  .cc-footer__bottom { margin-top:56px; padding-top:22px; border-top:1px solid rgba(255,255,255,.35); display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap; font-size:15px; color:#7C8794 !important; }
  .cc-footer__bottom span { color:#7C8794 !important; }
  .cc-footer__legal { display:flex; gap:24px; padding-right:72px; }
  .cc-footer__legal a { color:#B5BDC6 !important; text-decoration:none; } .cc-footer__legal a:hover { color:#fff !important; }
  .cc-wa { position:fixed; right:24px; bottom:24px; width:56px; height:56px; border-radius:50%; background:#25D366; display:grid; place-items:center; box-shadow:0 8px 20px rgba(0,0,0,.3); z-index:150; }
  @media (max-width:980px){ .cc-footer__top{ grid-template-columns:repeat(3,minmax(0,1fr)); gap:32px 24px; } .cc-footer__brand{ grid-column:1/-1; } }
  @media (max-width:768px){ .cc-footer{ padding:44px 0 24px; } .cc-footer .cc-wrap{ padding:0 20px; } .cc-footer__top{ grid-template-columns:1fr 1fr; } .cc-footer__col a{ font-size:15px; } .cc-footer__col ul{ gap:13px; } .cc-footer__legal{ padding-right:0; } .cc-footer__bottom{ margin-top:40px; } }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image (empty = CC mark)" },
    { "type": "range", "id": "logo_width", "min": 60, "max": 300, "step": 10, "unit": "px", "label": "Logo width", "default": 140 },
    { "type": "text", "id": "tagline", "label": "Tagline under name", "default": "Premium Indian menswear" },
    { "type": "textarea", "id": "description", "label": "Brand description", "default": "Modern silhouettes, premium fabrics, and a calm editorial aesthetic for the modern man." },
    { "type": "text", "id": "copyright", "label": "Copyright text", "default": "All rights reserved." },
    { "type": "checkbox", "id": "show_whatsapp", "label": "Show floating WhatsApp button", "default": true },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number (with country code)", "default": "919742377001" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Column title", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ]
}
{% endschema %}
