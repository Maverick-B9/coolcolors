{%- comment -%}
  Collection Filters
  Tag-based product filtering + sorting for a Shopify collection page.
  All filter groups are merchant-configured blocks below (label + the exact
  product tag values that belong to that group) since this store's tags are
  flat (e.g. "M", "Grey", "Solid") rather than namespaced. A "Price" block
  filters by variant price instead of a tag.

  Everything after first paint is driven by assets/filter.js, which fetches
  {{ collection.url }}/products.json client-side and filters/sorts in the
  browser. The markup below is just the initial skeleton + a no-JS fallback
  grid for crawlers/accessibility.
{%- endcomment -%}

{%- if collection -%}
<div
  class="pf-root"
  data-pf-root
  data-pf-collection-url="{{ collection.url }}"
>
  <script type="application/json" data-pf-config>
    {
      "collectionUrl": {{ collection.url | json }},
      "sortLabel": {{ section.settings.sort_label | json }},
      "columnsDesktop": {{ section.settings.columns_desktop | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "groups": [
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'size_filter' -%}
              {
                "type": "size",
                "key": {{ block.id | json }},
                "label": {{ block.settings.label | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- when 'color_filter' -%}
              {
                "type": "color",
                "key": {{ block.id | json }},
                "label": {{ block.settings.label | json }},
                "swatches": {{ block.settings.swatches | default: true | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- when 'price_group' -%}
              {
                "type": "price",
                "key": {{ block.id | json }},
                "label": {{ block.settings.label | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- when 'tag_group' -%}
              {
                "type": "tag",
                "key": {{ block.id | json }},
                "label": {{ block.settings.label | json }},
                "swatches": {{ block.settings.swatches | default: false | json }},
                "options": [
                  {%- assign tag_lines = block.settings.tags | split: newline -%}
                  {%- assign printed = 0 -%}
                  {%- for line in tag_lines -%}
                    {%- assign tag_value = line | strip -%}
                    {%- if tag_value != blank -%}
                      {%- if printed > 0 -%},{%- endif -%}{{ tag_value | json }}
                      {%- assign printed = printed | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                ]
              }{%- unless forloop.last -%},{%- endunless -%}
          {%- endcase -%}
        {%- endfor -%}
      ]
    }
  </script>

  <div class="pf-toolbar">
    <button type="button" class="pf-toolbar__trigger" data-pf-toggle aria-expanded="false" aria-controls="pf-panel-{{ section.id }}">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="4" y1="6" x2="20" y2="6"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="18" x2="20" y2="18"></line>
        <circle cx="9" cy="6" r="2" fill="currentColor"></circle>
        <circle cx="16" cy="12" r="2" fill="currentColor"></circle>
        <circle cx="11" cy="18" r="2" fill="currentColor"></circle>
      </svg>
      <span>Filters</span>
    </button>

    <span class="pf-toolbar__count" data-pf-count>{{ collection.products_count }} products</span>

    <div class="pf-toolbar__sort">
      <select class="pf-select" data-pf-sort aria-label="Sort products">
        <option value="newest">Newest First</option>
        <option value="price-asc">Price: Low to High</option>
        <option value="price-desc">Price: High to Low</option>
        <option value="title-asc">Alphabetically: A-Z</option>
        <option value="title-desc">Alphabetically: Z-A</option>
      </select>
    </div>
  </div>

  <div class="pf-loading-bar" data-pf-loading-bar hidden aria-hidden="true"></div>

  <div class="pf-mobile-bar" data-pf-mobile-bar>
    <button type="button" class="pf-mobile-bar__btn" data-pf-toggle aria-expanded="false" aria-controls="pf-panel-{{ section.id }}">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="4" y1="6" x2="20" y2="6"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="18" x2="20" y2="18"></line>
        <circle cx="9" cy="6" r="2" fill="currentColor"></circle>
        <circle cx="16" cy="12" r="2" fill="currentColor"></circle>
        <circle cx="11" cy="18" r="2" fill="currentColor"></circle>
      </svg>
      <span>Filters</span>
    </button>

    <span class="pf-mobile-bar__divider" aria-hidden="true"></span>

    <label class="pf-mobile-bar__btn pf-mobile-bar__sort">
      <span>Sort</span>
      <svg width="12" height="12" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M1 1l4 4 4-4"></path>
      </svg>
      <select class="pf-mobile-bar__select" data-pf-sort aria-label="Sort products">
        <option value="newest">Newest First</option>
        <option value="price-asc">Price: Low to High</option>
        <option value="price-desc">Price: High to Low</option>
        <option value="title-asc">Alphabetically: A-Z</option>
        <option value="title-desc">Alphabetically: Z-A</option>
      </select>
    </label>
  </div>

  <div class="pf-backdrop" data-pf-backdrop hidden></div>

  <div class="pf-panel" id="pf-panel-{{ section.id }}" data-pf-panel hidden>
    <div class="pf-panel__header">
      <h2 class="pf-panel__heading">Filters</h2>
      <button type="button" class="pf-panel__close" data-pf-close aria-label="Close filters">&times;</button>
    </div>

    <div class="pf-panel__body" data-pf-groups>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'size_filter', 'color_filter' -%}
            <details class="pf-group" data-pf-group data-pf-group-key="{{ block.id }}" open>
              <summary class="pf-group__title">{{ block.settings.label }}</summary>
              <div class="pf-group__options" data-pf-group-options></div>
            </details>
          {%- when 'tag_group' -%}
            {%- assign tag_lines = block.settings.tags | split: newline -%}
            {%- assign has_tags = false -%}
            {%- for line in tag_lines -%}{%- if line != blank -%}{%- assign has_tags = true -%}{%- endif -%}{%- endfor -%}
            {%- if has_tags -%}
              <details class="pf-group" data-pf-group data-pf-group-key="{{ block.id }}" open>
                <summary class="pf-group__title">{{ block.settings.label }}</summary>
                <div class="pf-group__options" data-pf-group-options></div>
              </details>
            {%- endif -%}
          {%- when 'price_group' -%}
            <details class="pf-group" data-pf-group data-pf-group-key="{{ block.id }}" open>
              <summary class="pf-group__title">{{ block.settings.label }}</summary>
              <div class="pf-price-inputs">
                <input type="number" min="0" class="pf-input" data-pf-price-min placeholder="Min">
                <input type="number" min="0" class="pf-input" data-pf-price-max placeholder="Max">
              </div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="pf-panel__actions">
      <button type="button" class="pf-btn pf-btn--ghost" data-pf-clear>Clear all</button>
      <button type="button" class="pf-btn pf-btn--primary" data-pf-close>View results</button>
    </div>
  </div>

  <div class="pf-grid" data-pf-grid>
    {%- comment -%}
      No-JS / pre-hydration fallback so crawlers and slow connections still see
      real products. Replaced entirely once filter.js loads. Sorted newest-first
      here to match filter.js's default state.sort - otherwise this would show
      the collection's native/admin-configured order and then visibly swap to a
      different order the instant JS finishes fetching, on every single load.
    {%- endcomment -%}
    {%- assign pf_initial_products = collection.products | sort: 'created_at' | reverse -%}
    {%- for product in pf_initial_products limit: section.settings.initial_count -%}
      {%- render 'filter-product-card', product: product -%}
    {%- endfor -%}
  </div>

  <div class="pf-grid-sentinel" data-pf-sentinel></div>
</div>

<script src="{{ 'filter.js' | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ 'filter.css' | asset_url }}">
{%- else -%}
  <p>{{ 'This section only works on a collection page.' }}</p>
{%- endif -%}

{% schema %}
{
  "name": "Collection Filters",
  "tag": "section",
  "class": "pf-section",
  "settings": [
    {
      "type": "text",
      "id": "sort_label",
      "label": "Default sort label",
      "default": "Newest First"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "initial_count",
      "label": "Products rendered before JS loads",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "size_filter",
      "name": "Size (auto)",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Group label",
          "default": "Size"
        }
      ]
    },
    {
      "type": "color_filter",
      "name": "Color (auto)",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Group label",
          "default": "Color"
        },
        {
          "type": "checkbox",
          "id": "swatches",
          "label": "Show as color swatches",
          "default": true
        }
      ]
    },
    {
      "type": "tag_group",
      "name": "Tag filter",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Group label",
          "default": "Fabric",
          "info": "For attributes not covered by the Size/Color blocks, e.g. Fabric, Pattern, Fit."
        },
        {
          "type": "textarea",
          "id": "tags",
          "label": "Tag values (one per line)",
          "info": "Must exactly match product tags in this store, e.g. Cotton / Linen / Denim."
        },
        {
          "type": "checkbox",
          "id": "swatches",
          "label": "Show as color swatches",
          "default": false
        }
      ]
    },
    {
      "type": "price_group",
      "name": "Price range",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Group label",
          "default": "Price"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collection Filters",
      "blocks": [
        { "type": "size_filter" },
        { "type": "price_group" },
        { "type": "color_filter" }
      ]
    }
  ]
}
{% endschema %}
